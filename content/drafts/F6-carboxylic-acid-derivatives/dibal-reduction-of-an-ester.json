  "steps": [
    {
      "stepKey": "hydride-transfer",
      "fromStateId": "reactants",
      "toStateId": "aluminium-acetal",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "π C2-O3 -> σ O3-Al10",
        "σ Al10-H11 -> σ C2-H11"
      ],
      "explanationAfterStep": "Aluminium binds the carbonyl oxygen as hydride moves to carbon (in reality the O–Al bond forms first). The product is a stable aluminium acetal: at −78 °C it does not lose ethoxide, so no aldehyde is formed while DIBAL-H is still present."
    },
    {
      "stepKey": "acid-work-up",
      "fromStateId": "aluminium-acetal",
      "toStateId": "acetal-and-acid",
      "stepKind": "change",
      "routePreference": "preferred",
      "addedSpecies": "[H:31][OH2+:30].[Cl-:32]",
      "caption": "Dilute aqueous acid is added at low temperature (work-up), once all the ester has been reduced."
    },
    {
      "stepKey": "ethoxy-protonation",
      "fromStateId": "acetal-and-acid",
      "toStateId": "protonated-acetal",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O4 -> σ O4-H31",
        "σ O30-H31 -> lp O30"
      ],
      "explanationAfterStep": "Protonation turns ethoxide into ethanol, a good leaving group."
    },
    {
      "stepKey": "ethanol-leaves",
      "fromStateId": "protonated-acetal",
      "toStateId": "aldehyde-complex",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O3 -> π C2-O3",
        "σ C2-O4 -> lp O4"
      ],
      "explanationAfterStep": "The oxygen on aluminium pushes out ethanol and the aldehyde C=O forms, still bound to aluminium."
    },
    {
      "stepKey": "aldehyde-release",
      "fromStateId": "aldehyde-complex",
      "toStateId": "products",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O30 -> σ O30-Al10",
        "σ O3-Al10 -> lp O3"
      ],
      "explanationAfterStep": "Water takes aluminium off the oxygen and benzaldehyde is released. No hydride is left by now, so the aldehyde survives: that is the point of DIBAL-H at −78 °C."
    }
  ],
  "mechanismSummary": "DIBAL-H binds the carbonyl oxygen of ethyl benzoate and delivers one hydride to the carbonyl carbon. At −78 °C the aluminium acetal formed is stable, so it is not turned into the aldehyde while hydride remains. In the acid work-up the OEt oxygen is protonated, ethanol leaves and water frees benzaldehyde from aluminium.",
  "references": [
    "Clayden, Greeves and Warren, Organic Chemistry, 2nd edition (Oxford University Press), chapter 10"
  ],
