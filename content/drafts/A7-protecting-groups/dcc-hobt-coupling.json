      ],
      "explanationAfterStep": "HOBt is acidic, and the isourea nitrogen is basic. The proton transfer gives OBt⁻, a good nucleophile, and turns the isourea into an even better leaving group."
    },
    {
      "stepKey": "obt-adds",
      "fromStateId": "isouronium-and-obt",
      "toStateId": "tetrahedral-1",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O40 -> σ O40-C2",
        "π C2-O3 -> lp O3"
      ],
      "explanationAfterStep": "OBt⁻ adds to the acyl carbon. This intercepts the O-acylisourea quickly, before it can rearrange to an N-acylurea or cyclise to an oxazolone (the cause of racemisation)."
    },
    {
      "stepKey": "dcu-leaves",
      "fromStateId": "tetrahedral-1",
      "toStateId": "active-ester",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
