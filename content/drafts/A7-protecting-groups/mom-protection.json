  "steps": [
    {
      "stepKey": "ionisation",
      "fromStateId": "reactants",
      "toStateId": "oxocarbenium",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O2 -> π O2-C3",
        "σ C3-Cl4 -> lp Cl4"
      ],
      "explanationAfterStep": "The oxygen lone pair pushes chloride out: the methoxymethyl cation is an oxocarbenium ion, a carbocation with an oxygen lone pair shared into it. α-Chloro ethers ionise easily for this reason."
    },
    {
      "stepKey": "alcohol-adds",
      "fromStateId": "oxocarbenium",
      "toStateId": "protonated-ether",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O11 -> σ O11-C3",
        "π C3-O2 -> lp O2"
      ],
      "explanationAfterStep": "The alcohol adds to the cation. The CH₂ now carries two oxygens: the MOM group is an acetal of formaldehyde."
    },
    {
      "stepKey": "sn2-substitution",
      "fromStateId": "reactants",
      "toStateId": "protonated-ether",
      "stepKind": "polar",
      "routePreference": "accepted",
      "canonicalArrows": [
        "lp O11 -> σ O11-C3",
        "σ C3-Cl4 -> lp Cl4"
      ],
      "explanationAfterStep": "Also accepted: a direct SN2 step at the CH₂. MOMCl reacts by both routes; the oxygen lone pair speeds up either one, which is why MOMCl alkylates so much faster than an ordinary primary chloride."
    },
    {
      "stepKey": "deprotonation",
      "fromStateId": "protonated-ether",
      "toStateId": "products",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N30 -> σ N30-H12",
        "σ O11-H12 -> lp O11"
      ],
      "explanationAfterStep": "Hünig's base takes the proton. A hindered, non-nucleophilic base is needed so that it removes protons without being alkylated by MOMCl itself."
    }
  ],
  "mechanismSummary": "The oxygen of chloromethyl methyl ether pushes chloride out, giving the methoxymethyl oxocarbenium ion (a direct SN2 step at the CH₂ is also accepted). The alcohol adds to it, and Hünig's base, too hindered to be alkylated, removes the proton. The MOM ether is an acetal of formaldehyde: stable to base, nucleophiles, hydrides and mild acid, removed by stronger acid (HCl in methanol). MOMCl is a carcinogen, so it is handled with care or replaced by dimethoxymethane with an acid catalyst.",
  "references": [
    "Clayden, Greeves and Warren, Organic Chemistry, 2nd edition (Oxford University Press), chapter 23",
    "Wuts, Greene's Protective Groups in Organic Synthesis, 5th edition (Wiley), chapter 2 (ethers and acetals)"
  ],
