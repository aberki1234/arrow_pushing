      ],
      "explanationAfterStep": "Piperidine removes the acidic fluorene C–H. The anion is aromatic: the five-membered ring carries six π electrons, like the cyclopentadienyl anion, and the charge spreads into both benzene rings."
    },
    {
      "stepKey": "e1cb-elimination",
      "fromStateId": "fluorenyl-anion",
      "toStateId": "dibenzofulvene",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp C1 -> π C1-C3",
        "σ C3-O4 -> lp O4"
      ],
      "explanationAfterStep": "The carbanion expels the carbamate from the next carbon: an E1cB elimination. Dibenzofulvene and the carbamate anion form."
    },
    {
      "stepKey": "piperidine-traps",
      "fromStateId": "dibenzofulvene",
      "toStateId": "adduct-zwitterion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
