      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "σ O5-O6 -> lp O6",
        "σ B4-C1 -> σ C1-O5"
      ],
      "explanationAfterStep": "A 1,2-shift from boron to oxygen. The carbon moves with its bonding pair, so its configuration is kept: OH replaces B exactly where boron was."
