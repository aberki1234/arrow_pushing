  "steps": [
    {
      "stepKey": "para-attack",
      "fromStateId": "reactants",
      "toStateId": "para-arenium-ion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "π C13-C14 -> σ C14-N2",
        "π N2-O3 -> lp O3"
      ],
      "explanationAfterStep": "Attack para to CH₃. The charge sits on C13, C15 and C11 in turn."
    },
    {
      "stepKey": "charge-moves-to-ipso-carbon",
      "fromStateId": "para-arenium-ion",
      "toStateId": "para-tertiary-form",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "π C11-C12 -> π C12-C13"
      ],
      "explanationAfterStep": "A resonance form, not a new species: here the positive charge is on a tertiary carbon, stabilised by the methyl group."
    },
    {
      "stepKey": "para-deprotonation",
      "fromStateId": "para-tertiary-form",
      "toStateId": "para-product",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O4 -> σ O4-H17",
        "σ C14-H17 -> π C13-C14",
        "π C12-C13 -> π C11-C12"
      ],
      "explanationAfterStep": "From any resonance form, losing H⁺ gives the same aromatic product."
    },
    {
      "stepKey": "ortho-attack",
      "fromStateId": "reactants",
      "toStateId": "ortho-arenium-ion",
      "stepKind": "polar",
      "routePreference": "accepted",
      "canonicalArrows": [
        "π C11-C12 -> σ C12-N2",
        "π N2-O3 -> lp O3"
      ],
      "explanationAfterStep": "Ortho attack is also correct: it puts the positive charge straight onto the carbon bearing CH₃. Toluene gives more ortho than para product (two ortho positions)."
    },
    {
      "stepKey": "ortho-deprotonation",
      "fromStateId": "ortho-arenium-ion",
      "toStateId": "ortho-product",
      "stepKind": "polar",
      "routePreference": "accepted",
      "canonicalArrows": [
        "lp O4 -> σ O4-H22",
        "σ C12-H22 -> π C11-C12"
      ],
      "explanationAfterStep": "2-Nitrotoluene: the ortho product."
    }
  ],
  "mechanismSummary": "Attack para (or ortho) to the methyl group gives an arenium ion with a resonance form in which the positive charge is on the carbon bearing CH₃: a tertiary carbocation, stabilised by the methyl group. Meta attack has no such form. Toluene gives about 58% ortho, 38% para and 4% meta product; para is drawn as the main route here, ortho is accepted.",
