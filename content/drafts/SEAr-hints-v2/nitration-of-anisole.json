      "stepKey": "electrophilic-attack",
      "stepKind": "polar",
      "toStateId": "arenium-ion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "π C13-C14 -> σ C14-N2",
        "π N2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Attack para to OMe. The positive charge is now spread over the two carbons next to the new C–N bond and the carbon bearing OMe."
    },
    {
      "stepKey": "charge-moves-to-ipso-carbon",
      "stepKind": "polar",
      "toStateId": "arenium-ion-ipso-cation",
      "fromStateId": "arenium-ion",
      "canonicalArrows": [
        "π C11-C12 -> π C12-C13"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A resonance form, not a new species: the charge can sit on the carbon bearing OMe. This is only possible after ortho or para attack."
    },
    {
      "stepKey": "oxygen-lone-pair-donates",
      "stepKind": "polar",
      "toStateId": "oxocarbenium",
      "fromStateId": "arenium-ion-ipso-cation",
      "canonicalArrows": [
        "lp O10 -> π O10-C11"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "In the oxocarbenium form every atom has an octet. This extra resonance form is why OMe is a strong ortho/para director and activates the ring."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "para-nitroanisole",
      "fromStateId": "oxocarbenium",
      "canonicalArrows": [
        "lp O4 -> σ O4-H17",
        "σ C14-H17 -> π C13-C14",
        "π C12-C13 -> π C11-C12",
        "π O10-C11 -> lp O10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Aromaticity is restored and sulfuric acid regenerated. From any resonance form of the arenium ion, losing H⁺ gives the same product."
    }
  ],
