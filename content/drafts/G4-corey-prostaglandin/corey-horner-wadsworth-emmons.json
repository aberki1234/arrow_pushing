  "steps": [
    {
      "stepKey": "deprotonation",
      "fromStateId": "reactants",
      "toStateId": "phosphonate-anion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp H51 -> σ H37-H51",
        "σ C36-H37 -> lp C36"
      ],
      "explanationAfterStep": "Hydride removes a proton from the CH₂ between the phosphonate and the ketone; H₂ bubbles off. The anion is stabilised by both groups, which makes it a soft, selective nucleophile."
    },
    {
      "stepKey": "addition",
      "fromStateId": "phosphonate-anion",
      "toStateId": "alkoxide",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp C36 -> σ C11-C36",
        "π C11-O12 -> lp O12"
      ],
      "explanationAfterStep": "The anion adds to the aldehyde, the most electrophilic carbonyl group present; the lactone and the acetate are left alone."
    },
    {
      "stepKey": "ring-closure",
      "fromStateId": "alkoxide",
      "toStateId": "oxaphosphetane",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O12 -> σ O12-P32",
        "π P32-O33 -> lp O33"
      ],
      "explanationAfterStep": "The alkoxide bonds to phosphorus, closing the four-membered oxaphosphetane."
    },
    {
      "stepKey": "cycloreversion",
      "fromStateId": "oxaphosphetane",
      "toStateId": "products",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "σ P32-C36 -> π C11-C36",
        "σ C11-O12 -> π O12-P32"
      ],
      "explanationAfterStep": "The ring falls apart to the C=C and a strong P=O. The dimethyl phosphate leaves as a water-soluble salt, easy to wash away, unlike Ph₃P=O. The addition is reversible, so the more stable trans arrangement of the two large groups wins, and the (E)-enone forms (not checked by the app yet)."
