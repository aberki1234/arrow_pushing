  "steps": [
    {
      "stepKey": "deprotonation",
      "fromStateId": "reactants",
      "toStateId": "phosphonate-anion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp H11 -> σ H6-H11",
        "σ C5-H6 -> lp C5"
      ],
      "explanationAfterStep": "The CH₂ is flanked by P=O and C=O (pKa about 19 in DMSO), so NaH removes a proton irreversibly: H₂ bubbles off. The charge is shared with the ester oxygen; drawing the enolate is also accepted."
    },
    {
      "stepKey": "addition",
      "fromStateId": "phosphonate-anion",
      "toStateId": "alkoxide",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp C5 -> σ C5-C12",
        "π C12-O13 -> lp O13"
      ],
      "explanationAfterStep": "The stabilised anion adds to the aldehyde. This addition is reversible, which matters for the alkene geometry."
    },
    {
      "stepKey": "ring-closure",
      "fromStateId": "alkoxide",
      "toStateId": "oxaphosphetane",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O13 -> σ O13-P1",
        "π P1-O2 -> lp O2"
      ],
      "explanationAfterStep": "The alkoxide attacks phosphorus to give a four-membered oxaphosphetane, with phosphorus briefly five-coordinate."
    },
    {
      "stepKey": "cycloreversion",
      "fromStateId": "oxaphosphetane",
      "toStateId": "products",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "σ P1-C5 -> π C5-C12",
        "σ C12-O13 -> π O13-P1"
      ],
      "explanationAfterStep": "The ring falls apart to the alkene and diethyl phosphate, which is water-soluble and washes out: an advantage over Ph₃P=O from the Wittig. The product is the E-alkene: because the addition is reversible, the reaction runs through the less crowded intermediate with the ester and the phenyl group apart. The app does not check E/Z yet."
    }
  ],
  "mechanismSummary": "Sodium hydride removes the acidic proton between the P=O and the ester. The stabilised anion adds to benzaldehyde, the alkoxide attacks phosphorus to close an oxaphosphetane, and the ring breaks into ethyl cinnamate and diethyl phosphate. Like a Wittig with a stabilised ylide, but the anion is more nucleophilic, the by-product washes out with water, and the E-alkene is formed almost exclusively (the app does not check E/Z yet).",
  "references": [
    "Clayden, Greeves and Warren, Organic Chemistry, 2nd edition (Oxford University Press), chapter 27"
  ],
