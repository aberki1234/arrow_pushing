  "steps": [
    {
      "stepKey": "deprotonation",
      "fromStateId": "reactants",
      "toStateId": "trichloromethanide",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O6 -> σ O6-H2",
        "σ C1-H2 -> lp C1"
      ],
      "explanationAfterStep": "The three chlorines stabilise the negative charge by induction."
    },
    {
      "stepKey": "alpha-elimination",
      "fromStateId": "trichloromethanide",
      "toStateId": "dichlorocarbene",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "σ C1-Cl5 -> lp Cl5"
      ],
      "explanationAfterStep": "Chloride leaves from the carbon that carries the lone pair: an α-elimination (1,1-elimination). The product, dichlorocarbene, is a neutral carbon with only two bonds and six electrons: a lone pair in an sp² orbital and an empty p orbital (a singlet carbene). The chlorine lone pairs feed the empty p orbital, so :CCl₂ is one of the more stable carbenes."
    },
    {
      "stepKey": "cyclopropanation",
      "fromStateId": "dichlorocarbene",
      "toStateId": "products",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "π C12-C13 -> σ C1-C12",
        "lp C1 -> σ C1-C13"
      ],
      "explanationAfterStep": "Both new bonds form in one step (a cheletropic addition), so the alkene geometry is kept: a cis-alkene gives a cis-disubstituted cyclopropane. The app does not check stereochemistry yet."
    }
  ],
  "mechanismSummary": "tert-Butoxide removes the acidic proton of chloroform. The trichloromethyl anion loses chloride from the same carbon (α-elimination) to give dichlorocarbene, a singlet carbene. It adds to the alkene in one step, forming both C–C bonds at once, so the alkene geometry is kept in the cyclopropane. The same carbene is made on a large scale from CHCl₃ and 50% NaOH(aq) with a phase-transfer catalyst.",
  "references": [
    "Clayden, Greeves and Warren, Organic Chemistry, 2nd edition (Oxford University Press), chapter 38"
  ],
