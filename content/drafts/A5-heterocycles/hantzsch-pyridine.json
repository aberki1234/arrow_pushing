      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N1 -> π N1-C2",
        "π C2-C3 -> σ C3-C13",
        "π C13-C14 -> π C14-C15",
        "π C15-O16 -> lp O16"
      ],
      "explanationAfterStep": "An enamine is a neutral enolate equivalent: the nitrogen lone pair pushes, and the carbon at the far end of the C=C attacks. The acceptor is doubly activated (a ketone and an ester), so the negative charge is well spread. Pushing the charge onto the ester oxygen instead is also accepted: it is the same enolate."
    },
    {
      "stepKey": "c-protonation",
      "fromStateId": "michael-adduct",
      "toStateId": "keto-iminium",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "π C14-C15 -> σ C14-H42",
        "σ O26-H42 -> lp O26",
        "lp O16 -> π C15-O16"
      ],
      "explanationAfterStep": "Protonation on carbon gives back the ketone. (Protonation on oxygen to the enol, then tautomerisation, ends in the same place.)"
    },
    {
      "stepKey": "enamine-regeneration",
      "fromStateId": "keto-iminium",
      "toStateId": "enamine-ketone",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O26 -> σ O26-H41",
        "σ C3-H41 -> π C2-C3",
        "π N1-C2 -> lp N1"
      ],
      "explanationAfterStep": "The iminium ion loses the proton next to it and becomes an enamine again, now carrying a 3-oxobutyl chain. Its NH₂ group is free to attack the ketone."
    },
    {
      "stepKey": "ring-closure",
      "fromStateId": "enamine-ketone",
      "toStateId": "cyclic-zwitterion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N1 -> σ N1-C15",
        "π C15-O16 -> lp O16"
      ],
      "explanationAfterStep": "Attack on the ketone closes a six-membered ring, the step that makes the heterocycle."
    },
    {
