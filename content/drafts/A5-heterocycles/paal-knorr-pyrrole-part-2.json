  "steps": [
    {
      "stepKey": "first-protonation",
      "fromStateId": "reactants",
      "toStateId": "protonated-hydroxyl",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O3 -> σ O3-H20",
        "σ O16-H20 -> lp O16"
      ],
      "explanationAfterStep": "Protonation turns OH into OH₂⁺, so that the leaving group is neutral water. The two OH groups are identical, so either may go first."
    },
    {
      "stepKey": "first-loss-of-water",
      "fromStateId": "protonated-hydroxyl",
      "toStateId": "iminium-ion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N9 -> π C2-N9",
        "σ C2-O3 -> lp O3"
      ],
      "explanationAfterStep": "The nitrogen lone pair pushes water out, giving an iminium ion rather than a bare carbocation."
    },
    {
      "stepKey": "enamine-formation",
      "fromStateId": "iminium-ion",
      "toStateId": "enamine",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O16 -> σ O16-H18",
        "σ C4-H18 -> π C2-C4",
        "π C2-N9 -> lp N9"
      ],
      "explanationAfterStep": "Losing a proton next to the iminium carbon gives an enamine, exactly as when a secondary amine meets a ketone. The nitrogen lone pair is free again to push out the second water."
    },
    {
      "stepKey": "second-protonation",
      "fromStateId": "enamine",
      "toStateId": "second-protonated-hydroxyl",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O7 -> σ O7-H18",
        "σ O16-H18 -> lp O16"
      ],
      "explanationAfterStep": "The second OH is protonated in the same way."
    },
    {
      "stepKey": "second-loss-of-water",
      "fromStateId": "second-protonated-hydroxyl",
      "toStateId": "second-iminium-ion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N9 -> π C6-N9",
        "σ C6-O7 -> lp O7"
      ],
      "explanationAfterStep": "The nitrogen lone pair pushes out the second water. The cation is a protonated pyrrole (a 2H-pyrrolium ion): it is one proton away from aromatic."
    },
    {
      "stepKey": "aromatisation",
      "fromStateId": "second-iminium-ion",
      "toStateId": "products",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O16 -> σ O16-H19",
        "σ C5-H19 -> π C5-C6",
        "π C6-N9 -> lp N9"
      ],
      "explanationAfterStep": "Losing the last proton gives the aromatic pyrrole: the nitrogen lone pair joins the four π electrons of the two C=C bonds to make a sextet. Aromaticity is the driving force of the whole sequence."
    }
  ],
  "mechanismSummary": "The cyclic bis-hemiaminal from Part 1 loses two molecules of water. Each time, acetic acid protonates an OH group, the nitrogen lone pair pushes water out to give an iminium ion, and acetate removes a proton from the next carbon. After the second loss of water the last deprotonation makes the ring aromatic: 1,2,5-trimethylpyrrole.",
  "references": [
    "Clayden, Greeves and Warren, Organic Chemistry, 2nd edition (Oxford University Press), chapter 30"
  ],
