      "explanationAfterStep": "The aniline nitrogen adds to the iminium ion, as an amine adds to a carbonyl group, closing a five-membered ring."
    },
    {
      "stepKey": "nitrogen-deprotonation",
      "fromStateId": "cyclic-aminal",
      "toStateId": "neutral-aminal",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O38 -> σ O38-H20",
        "σ N4-H20 -> lp N4"
      ],
      "explanationAfterStep": "Acetate removes a proton from the ring nitrogen, freeing its lone pair."
    },
    {
      "stepKey": "amine-protonation",
      "fromStateId": "neutral-aminal",
      "toStateId": "ammonium",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N3 -> σ N3-H22",
        "σ O33-H22 -> lp O33"
      ],
      "explanationAfterStep": "Protonating the NH₂ group turns it into a good leaving group: neutral ammonia."
    },
    {
      "stepKey": "loss-of-ammonia",
      "fromStateId": "ammonium",
      "toStateId": "indoleninium-ion",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N4 -> π C2-N4",
        "σ C2-N3 -> lp N3"
      ],
      "explanationAfterStep": "The ring nitrogen lone pair pushes out ammonia; in acid the ammonia ends up as ammonium acetate. This is the step that gives the synthesis its overall result: one nitrogen of the hydrazine is lost."
