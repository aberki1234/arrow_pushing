  "steps": [
    {
      "stepKey": "conjugate-addition",
      "fromStateId": "reactants",
      "toStateId": "sigma-complex",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "π C22-C23 -> σ C4-C22",
        "π C24-C25 -> π C23-C24",
        "lp N21 -> π N21-C25",
        "π C3-C4 -> π C1-C3",
        "π C1-N40 -> lp N40"
      ],
      "explanationAfterStep": "The nucleophile adds 1,4 to the LUMO-lowered iminium ion, which becomes an enamine. Pyrrole attacks through the carbon next to nitrogen, giving a cation shared by nitrogen and two ring carbons. The catalyst's benzyl group blocks one face of the C=C, so the pyrrole adds from the other: the new stereocentre forms in about 90 % ee. The app does not check stereochemistry yet, so the drawings carry no wedges and either face is accepted."
    },
    {
      "stepKey": "rearomatisation",
      "fromStateId": "sigma-complex",
      "toStateId": "enamine",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O61 -> σ O61-H27",
        "σ C22-H27 -> π C22-C23",
        "π C23-C24 -> π C24-C25",
        "π N21-C25 -> lp N21"
      ],
      "explanationAfterStep": "Loss of the proton restores the aromatic pyrrole, as in every electrophilic aromatic substitution: overall this is a Friedel–Crafts alkylation, done by conjugate addition."
    },
    {
      "stepKey": "enamine-protonation",
      "fromStateId": "enamine",
      "toStateId": "iminium-2",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N40 -> π N40-C1",
        "π C1-C3 -> σ C3-H27",
        "σ O61-H27 -> lp O61"
      ],
      "explanationAfterStep": "The proton taken from the ring goes back onto the enamine carbon, giving a saturated iminium ion. Iminium catalysis therefore passes through enamine chemistry too."
    },
    {
      "stepKey": "general-base-water-addition",
      "fromStateId": "iminium-2",
      "toStateId": "carbinolamine",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O61 -> σ O61-H71",
        "σ O70-H71 -> lp O70",
        "lp O70 -> σ O70-C1",
        "π C1-N40 -> lp N40"
      ],
      "explanationAfterStep": "Water in the solvent (THF with a little water) hydrolyses the iminium ion; trifluoroacetate takes a proton as water adds."
    },
    {
      "stepKey": "nitrogen-protonation",
      "fromStateId": "carbinolamine",
      "toStateId": "ammonium",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp N40 -> σ N40-H71",
        "σ O61-H71 -> lp O61"
      ],
      "explanationAfterStep": "TFA protonates the nitrogen, so the catalyst can leave as a neutral amine."
    },
    {
      "stepKey": "catalyst-release",
      "fromStateId": "ammonium",
      "toStateId": "products",
      "stepKind": "polar",
      "routePreference": "preferred",
      "canonicalArrows": [
        "lp O61 -> σ O61-H72",
        "σ O70-H72 -> π C1-O70",
        "σ C1-N40 -> lp N40"
      ],
      "explanationAfterStep": "The aldehyde re-forms and the amine leaves; with TFA it forms the iminium ion of the next crotonaldehyde. The saturated aldehyde cannot form a conjugated iminium ion, so it does not react again."
    }
  ],
  "mechanismSummary": "Paras and MacMillan (2001) used iminium activation for a conjugate addition that enals alone do not undergo: N-methylpyrrole adds 1,4 to crotonaldehyde. The iminium ion (formed as in the Diels–Alder reaction, with TFA as the acid) is attacked at its far carbon by the pyrrole carbon next to nitrogen, giving an enamine and a pyrrolium cation. Trifluoroacetate restores the aromatic ring by removing a proton, and the TFA formed protonates the enamine carbon to give a saturated iminium ion. Water then hydrolyses it (addition with trifluoroacetate as general base, N-protonation, release) to the aldehyde and the free catalyst. The catalyst's benzyl group shields one face of the iminium ion, so the 3-pyrrolylbutanal forms with high ee. Iminium and enamine catalysis are two halves of one cycle here. The app does not check stereochemistry yet, so the drawings carry no wedges and either face is accepted.",
  "references": [
    "Paras and MacMillan, Journal of the American Chemical Society 2001, 123, 4370",
    "Clayden, Greeves and Warren, Organic Chemistry, 2nd edition (Oxford University Press), chapter 41 (asymmetric synthesis: organocatalysis)",
    "Clayden, Greeves and Warren, Organic Chemistry, 2nd edition (Oxford University Press), chapter 22 (conjugate addition)"
  ],
