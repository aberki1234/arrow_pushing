{
  "steps": [
    {
      "stepKey": "amine-addition",
      "stepKind": "polar",
      "toStateId": "zwitterion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N30 -> σ N30-C12",
        "π C12-O13 -> σ O13-H35",
        "σ O34-H35 -> lp O34"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Proline is a bifunctional catalyst: the amine adds while its own carboxylic acid protonates the oxygen. The open methyl ketone reacts; the hindered ring ketones do not."
    },
    {
      "stepKey": "nitrogen-deprotonation",
      "stepKind": "polar",
      "toStateId": "carbinolamine",
      "fromStateId": "zwitterion",
      "canonicalArrows": [
        "lp O34 -> σ O34-H39",
        "σ N30-H39 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The carboxylate takes the N–H proton back, so the carboxylic acid is ready to act again."
    },
    {
      "stepKey": "hydroxyl-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-carbinolamine",
      "fromStateId": "carbinolamine",
      "canonicalArrows": [
        "lp O13 -> σ O13-H39",
        "σ O34-H39 -> lp O34"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Acid catalysis again: the OH becomes OH₂⁺, and water is a good leaving group."
    },
    {
      "stepKey": "loss-of-water",
      "stepKind": "polar",
      "toStateId": "iminium",
      "fromStateId": "protonated-carbinolamine",
      "canonicalArrows": [
        "lp N30 -> π N30-C12",
        "σ C12-O13 -> lp O13"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The nitrogen lone pair pushes water out, giving an iminium ion with the carboxylate as its counter-ion in the same molecule."
    },
    {
      "stepKey": "enamine-formation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "iminium",
      "canonicalArrows": [
        "lp O34 -> σ O34-H15",
        "σ C14-H15 -> π C12-C14",
        "π C12-N30 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Losing a methyl proton gives the less substituted enamine. Its nucleophilic CH₂ carbon is five bonds from either ring carbonyl carbon: the right distance for a six-membered ring. The carboxylic acid is back, ready to deliver a proton in the ring closure."
    }
  ],
