        "σ O5-H7 -> lp O5"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "H₂O₂ (pKa about 11.6) is more acidic than water, so hydroxide makes the hydroperoxide anion."
    },
    {
      "stepKey": "hydroperoxide-adds",
      "stepKind": "polar",
      "toStateId": "borate",
      "fromStateId": "hydroperoxide",
      "canonicalArrows": [
        "lp O5 -> σ O5-B4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A tetrahedral borate. The peroxide O–O bond is now set up to break."
    },
    {
      "stepKey": "alkyl-shift",
      "stepKind": "polar",
      "toStateId": "borate-ester",
      "fromStateId": "borate",
      "canonicalArrows": [
        "σ O5-O6 -> lp O6",
        "σ B4-C1 -> σ C1-O5"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A 1,2-shift from boron to oxygen. The carbon moves with its bonding pair, so its configuration is kept: OH replaces B exactly where boron was."
    },
    {
      "stepKey": "hydroxide-adds",
      "stepKind": "polar",
      "toStateId": "hydroxyborate",
      "fromStateId": "borate-ester",
      "canonicalArrows": [
        "lp O6 -> σ O6-B4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Hydroxide adds to boron, just as the hydroperoxide did."
    },
    {
      "stepKey": "propoxide-leaves",
      "stepKind": "polar",
      "toStateId": "propoxide",
      "fromStateId": "hydroxyborate",
      "canonicalArrows": [
        "σ B4-O5 -> lp O5"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The propoxide leaves boron."
    },
    {
      "stepKey": "protonation",
      "stepKind": "polar",
      "toStateId": "product",
      "fromStateId": "propoxide",
      "canonicalArrows": [
        "lp O5 -> σ O5-H7",
        "σ H7-O8 -> lp O8"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Propan-1-ol. Each remaining propyl group goes through the same sequence, so one BH₃ gives three alcohols and borate."
    }
  ],
