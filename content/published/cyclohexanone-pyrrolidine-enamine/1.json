{
  "steps": [
    {
      "stepKey": "amine-addition",
      "stepKind": "polar",
      "toStateId": "zwitterion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N8 -> σ C1-N8",
        "π C1-O2 -> lp O2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The secondary amine adds to the neutral ketone, as a primary amine would."
    },
    {
      "stepKey": "oxygen-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-adduct",
      "fromStateId": "zwitterion",
      "canonicalArrows": [
        "lp O2 -> σ O2-H15",
        "σ O14-H15 -> lp O14"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "TsOH protonates the alkoxide; its conjugate base, tosylate, is very weakly basic."
    },
    {
      "stepKey": "nitrogen-deprotonation",
      "stepKind": "polar",
      "toStateId": "hemiaminal",
      "fromStateId": "protonated-adduct",
      "canonicalArrows": [
        "lp O14 -> σ O14-H13",
        "σ N8-H13 -> lp N8"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Removing the N–H proton gives the neutral hemiaminal and TsOH again."
    },
    {
      "stepKey": "hydroxyl-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-hemiaminal",
      "fromStateId": "hemiaminal",
      "canonicalArrows": [
        "lp O2 -> σ O2-H13",
        "σ O14-H13 -> lp O14"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The protonated OH can leave as water."
    },
    {
      "stepKey": "loss-of-water",
      "stepKind": "polar",
      "toStateId": "iminium-and-water",
      "fromStateId": "protonated-hemiaminal",
      "canonicalArrows": [
        "lp N8 -> π C1-N8",
        "σ C1-O2 -> lp O2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The nitrogen lone pair pushes out water: an iminium ion forms. Nitrogen now has three bonds to carbon and no hydrogen."
    },
    {
      "caption": "The water distils off with the toluene and is trapped (Dean–Stark), so the reaction cannot reverse.",
      "stepKey": "water-removed",
      "stepKind": "change",
      "toStateId": "iminium",
      "fromStateId": "iminium-and-water",
      "routePreference": "preferred",
      "removedFragmentMapNumbers": [
        2
      ]
    },
    {
      "stepKey": "enamine-formation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "iminium",
      "canonicalArrows": [
        "lp O14 -> σ O14-H20",
        "σ C3-H20 -> π C1-C3",
        "π C1-N8 -> lp N8"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A secondary amine has no N–H left on the iminium ion, so a C–H proton next to the C=N⁺ carbon is lost instead. The enamine is a neutral, nucleophilic alkene: its nitrogen lone pair pushes into the C=C."
    }
  ],
