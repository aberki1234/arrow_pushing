{
  "steps": [
    {
      "stepKey": "ylide-formation",
      "stepKind": "polar",
      "toStateId": "ylide",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N30 -> σ N30-H8",
        "σ C2-H8 -> lp C2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The ylide is also an N-heterocyclic carbene (NHC): in its other resonance form the ring carbon is neutral with a lone pair and an empty p orbital. Only a little forms with Et₃N, but it is enough."
    },
    {
      "stepKey": "addition-to-aldehyde",
      "stepKind": "polar",
      "toStateId": "alkoxide",
      "fromStateId": "ylide",
      "canonicalArrows": [
        "lp C2 -> σ C2-C40",
        "π C40-O41 -> lp O41"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The carbene adds to benzaldehyde like cyanide in the classical benzoin reaction."
    },
    {
      "stepKey": "alkoxide-protonation",
      "stepKind": "polar",
      "toStateId": "adduct",
      "fromStateId": "alkoxide",
      "canonicalArrows": [
        "lp O41 -> σ O41-H8",
        "σ N30-H8 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A proton transfer: triethylammonium gives back the proton it took."
    },
    {
      "stepKey": "breslow-intermediate-formation",
      "stepKind": "polar",
      "toStateId": "breslow-intermediate",
      "fromStateId": "adduct",
      "canonicalArrows": [
        "lp N30 -> σ N30-H42",
        "σ C40-H42 -> π C2-C40",
        "π C2-N3 -> lp N3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Breslow proposed this enaminol in 1958. The former aldehyde carbon is now nucleophilic: the catalyst has reversed its polarity (umpolung), turning an acyl cation equivalent into an acyl anion equivalent."
    },
    {
      "stepKey": "addition-to-second-aldehyde",
      "stepKind": "polar",
      "toStateId": "second-alkoxide",
      "fromStateId": "breslow-intermediate",
      "canonicalArrows": [
        "lp N3 -> π C2-N3",
        "π C2-C40 -> σ C40-C50",
        "π C50-O51 -> lp O51"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The new C–C bond joins two aldehyde carbons, something no ordinary enolate could do: benzaldehyde has no α-hydrogen. With a chiral triazolium carbene this step makes benzoin in high ee. Stereochemistry is not checked by the app yet."
    },
    {
      "stepKey": "second-alkoxide-protonation",
      "stepKind": "polar",
      "toStateId": "diol-adduct",
      "fromStateId": "second-alkoxide",
      "canonicalArrows": [
        "lp O51 -> σ O51-H42",
        "σ N30-H42 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The new OH becomes benzoin's hydroxyl group."
    },
    {
      "stepKey": "catalyst-release",
      "stepKind": "polar",
      "toStateId": "benzoin-and-ylide",
      "fromStateId": "diol-adduct",
      "canonicalArrows": [
        "lp N30 -> σ N30-H8",
        "σ O41-H8 -> π C40-O41",
        "σ C2-C40 -> lp C2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The ketone forms and the ylide leaves: the reverse of an addition to a ketone, with the ylide as leaving group, just as cyanide leaves a cyanohydrin."
    },
    {
      "stepKey": "ylide-protonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "benzoin-and-ylide",
      "canonicalArrows": [
        "lp C2 -> σ C2-H8",
        "σ N30-H8 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The catalyst rests as the thiazolium salt until the next turn. Every step is reversible, so benzoin can also go back to benzaldehyde."
    }
  ],
