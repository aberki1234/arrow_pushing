  "steps": [
    {
      "stepKey": "sulfonylation",
      "stepKind": "polar",
      "toStateId": "protonated-tosylate",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O5 -> σ O5-S6",
        "σ S6-Cl17 -> lp Cl17"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Substitution at sulfur, drawn here in one step. The C–O bond of the alcohol is not broken, so a stereocentre at that carbon keeps its configuration."
    },
    {
      "stepKey": "addition-to-sulfur",
      "stepKind": "polar",
      "toStateId": "sulfur-intermediate",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O5 -> σ O5-S6",
        "π S6-O7 -> lp O7"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct: an S=O π bond takes the electrons first, giving a five-coordinate sulfur intermediate. Chloride is lost in the next step."
    },
    {
      "stepKey": "chloride-loss",
      "stepKind": "polar",
      "toStateId": "protonated-tosylate",
      "fromStateId": "sulfur-intermediate",
      "canonicalArrows": [
        "lp O7 -> π O7-S6",
        "σ S6-Cl17 -> lp Cl17"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The S=O bond re-forms and chloride leaves: the same protonated tosylate as the one-step route."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "protonated-tosylate",
      "canonicalArrows": [
        "lp N18 -> σ N18-H16",
        "σ O5-H16 -> lp O5"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Butan-2-yl tosylate: OTs is now an excellent leaving group, about as good as a halide. Pyridine is a weak base, but strong enough to take a proton from a positive oxygen, and it neutralises the HCl formed."
    }
  ],
