{
  "steps": [
    {
      "stepKey": "kinetic-deprotonation",
      "stepKind": "polar",
      "toStateId": "kinetic-enolate",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N10 -> σ N10-H20",
        "σ C7-H20 -> π C1-C7",
        "π C1-O2 -> lp O2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The kinetic enolate. The CH₂ side has two hydrogens and no methyl group in the way, so the bulky base removes one of them faster. At −78 °C with no proton source the enolates cannot interconvert, so the faster-formed one is what you get."
    },
    {
      "stepKey": "thermodynamic-deprotonation",
      "stepKind": "polar",
      "toStateId": "thermodynamic-enolate",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N10 -> σ N10-H21",
        "σ C3-H21 -> π C1-C3",
        "π C1-O2 -> lp O2"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct, but minor here: this is the thermodynamic enolate. Its C=C bond carries more alkyl groups, so it is more stable, and it wins when the enolates can equilibrate (a weaker base, a proton source, higher temperature). The hindered proton next to the methyl group makes it form more slowly with LDA."
    },
    {
      "caption": "Iodomethane is added at −78 °C.",
      "stepKey": "iodomethane-added",
      "stepKind": "change",
      "toStateId": "kinetic-enolate-and-iodomethane",
      "fromStateId": "kinetic-enolate",
      "addedSpecies": "[CH3:17][I:18]",
      "routePreference": "preferred"
    },
    {
      "caption": "Iodomethane is added at −78 °C.",
      "stepKey": "iodomethane-added-to-thermodynamic",
      "stepKind": "change",
      "toStateId": "thermodynamic-enolate-and-iodomethane",
      "fromStateId": "thermodynamic-enolate",
      "addedSpecies": "[CH3:17][I:18]",
      "routePreference": "accepted"
    },
    {
      "stepKey": "kinetic-alkylation",
      "stepKind": "polar",
      "toStateId": "kinetic-product",
      "fromStateId": "kinetic-enolate-and-iodomethane",
      "canonicalArrows": [
        "lp O2 -> π C1-O2",
        "π C1-C7 -> σ C7-C17",
        "σ C17-I18 -> lp I18"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The new methyl group goes where the C=C bond was: on the side away from the first methyl group, giving 2,6-dimethylcyclohexanone."
    },
    {
      "stepKey": "thermodynamic-alkylation",
      "stepKind": "polar",
      "toStateId": "thermodynamic-product",
      "fromStateId": "thermodynamic-enolate-and-iodomethane",
      "canonicalArrows": [
        "lp O2 -> π C1-O2",
        "π C1-C3 -> σ C3-C17",
        "σ C17-I18 -> lp I18"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "This enolate puts the second methyl group on the carbon that already has one: 2,2-dimethylcyclohexanone. It is the minor product under these conditions."
    }
