{
  "steps": [
    {
      "stepKey": "hydrazone-protonation",
      "stepKind": "polar",
      "toStateId": "hydrazonium-ion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N3 -> σ N3-H34",
        "σ O33-H34 -> lp O33"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Protonating the C=N nitrogen makes the hydrazone an iminium ion, ready to lose a C–H proton."
    },
    {
      "stepKey": "tautomerisation",
      "stepKind": "polar",
      "toStateId": "ene-hydrazine",
      "fromStateId": "hydrazonium-ion",
      "canonicalArrows": [
        "lp O33 -> σ O33-H23",
        "σ C1-H23 -> π C1-C2",
        "π C2-N3 -> lp N3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Just as an imine is in equilibrium with its enamine, a hydrazone is in equilibrium with its ene-hydrazine. Only a little is present, but it is the tautomer that rearranges."
    },
    {
      "stepKey": "ene-hydrazine-protonation",
      "stepKind": "polar",
      "toStateId": "ene-hydrazinium-ion",
      "fromStateId": "ene-hydrazine",
      "canonicalArrows": [
        "lp N3 -> σ N3-H39",
        "σ O38-H39 -> lp O38"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Protonation weakens the N–N bond and speeds up the rearrangement."
    },
    {
      "stepKey": "3-3-sigmatropic-rearrangement",
      "stepKind": "polar",
      "toStateId": "rearranged-imine",
      "fromStateId": "ene-hydrazinium-ion",
      "canonicalArrows": [
        "σ N3-N4 -> π C2-N3",
        "π C1-C2 -> σ C1-C6",
        "π C5-C6 -> π C5-N4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A [3,3]-sigmatropic rearrangement, like a Cope or Claisen rearrangement, through a chair-like six-membered transition state. The weak N–N bond is traded for a strong C–C bond, at the cost (for now) of the benzene ring's aromaticity. The new bond is to the carbon ortho to nitrogen."
    },
    {
      "stepKey": "imine-protonation",
      "stepKind": "polar",
      "toStateId": "dication",
      "fromStateId": "rearranged-imine",
      "canonicalArrows": [
        "lp N4 -> σ N4-H23",
        "σ O33-H23 -> lp O33"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Protonating the imine nitrogen sets up the tautomerisation back to an aromatic amine."
    },
    {
      "stepKey": "rearomatisation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "dication",
      "canonicalArrows": [
        "lp O33 -> σ O33-H22",
        "σ C6-H22 -> π C5-C6",
        "π C5-N4 -> lp N4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Losing the proton restores the benzene ring and leaves an aniline NH₂ group next to an iminium ion. Part 2 joins them."
    }
  ],
