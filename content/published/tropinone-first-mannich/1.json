      "toStateId": "protonated-ketone",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O19 -> σ O19-H26",
        "σ O25-H26 -> lp O25"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Acid-catalysed enolisation starts by protonating the ketone (see Enols and enolates)."
    },
    {
      "stepKey": "enol-formation",
      "stepKind": "polar",
      "toStateId": "enol",
      "fromStateId": "protonated-ketone",
      "canonicalArrows": [
        "lp O27 -> σ O27-H24",
        "σ C17-H24 -> π C17-C18",
        "π C18-O19 -> lp O19"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The enol forms. Each CH₂ of acetonedicarboxylic acid sits between a ketone and a CO₂H, so it enolises far more than acetone does: that is why Robinson's yield jumped when he replaced acetone by acetonedicarboxylic acid."
    },
    {
      "stepKey": "first-mannich",
      "stepKind": "polar",
      "toStateId": "oxocarbenium",
      "fromStateId": "enol",
      "canonicalArrows": [
        "lp O19 -> π C18-O19",
        "π C17-C18 -> σ C2-C17",
        "π C2-N7 -> lp N7"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The first new C–C bond. The iminium carbon is attacked, the nitrogen gets its lone pair back, and the charge ends on the protonated ketone. Two new stereocentres form here; their relative configuration does not matter, as both are lost or fixed later. The app does not check stereochemistry yet."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "oxocarbenium",
      "canonicalArrows": [
        "lp O25 -> σ O25-H26",
        "σ O19-H26 -> lp O19"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Losing the proton gives the ketone. The product still carries an OH next to the nitrogen: a hidden second iminium ion. Its other CH₂ can enolise again, so everything for the second Mannich reaction is in one molecule."
    }
  ],
