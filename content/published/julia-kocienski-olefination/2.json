{
  "steps": [
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "sulfonyl-anion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N12 -> σ N12-H2",
        "σ C1-H2 -> lp C1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The sulfonyl group stabilises the carbanion (pKa about 30). KHMDS is added to the sulfone and the aldehyde together, so the anion meets the aldehyde at once."
    },
    {
      "stepKey": "addition",
      "stepKind": "polar",
      "toStateId": "alkoxide",
      "fromStateId": "sulfonyl-anion",
      "canonicalArrows": [
        "lp C1 -> σ C1-C22",
        "π C22-O23 -> lp O23"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The anion adds to the aldehyde, giving a β-alkoxy sulfone."
    },
    {
      "stepKey": "smiles-addition",
      "stepKind": "polar",
      "toStateId": "spiro-adduct",
      "fromStateId": "alkoxide",
      "canonicalArrows": [
        "lp O23 -> σ O23-C7",
        "π C7-N8 -> lp N8"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "An intramolecular nucleophilic aromatic substitution begins: the alkoxide adds to the electron-poor tetrazole carbon through a five-membered ring."
    },
    {
      "stepKey": "smiles-collapse",
      "stepKind": "polar",
      "toStateId": "sulfinate",
      "fromStateId": "spiro-adduct",
      "canonicalArrows": [
        "lp N8 -> π C7-N8",
        "σ C7-S4 -> lp S4",
        "π S4-O5 -> lp O5"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The tetrazole has moved from sulfur to oxygen: a Smiles rearrangement. Sulfur is now a sulfinate (the drawing with the negative charge on sulfur is also accepted), and the tetrazolyl ether is a good leaving group."
    },
    {
      "stepKey": "elimination",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "sulfinate",
      "canonicalArrows": [
        "lp O5 -> π O5-S4",
        "σ S4-C1 -> π C1-C22",
        "σ C22-O23 -> lp O23"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "SO₂ and the tetrazolyloxide leave in one anti-periplanar elimination, so the alkene geometry is set by which diastereomer of the alkoxide formed. PT-sulfones usually give mainly the E-alkene. The app does not check E/Z yet."
    }
  ],
