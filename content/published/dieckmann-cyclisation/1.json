      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The molecule is symmetrical, so either end can be deprotonated: the result is the same."
    },
    {
      "stepKey": "ring-closure",
      "stepKind": "polar",
      "toStateId": "cyclic-intermediate",
      "fromStateId": "enolate",
      "canonicalArrows": [
        "lp O11 -> π C10-O11",
        "π C9-C10 -> σ C1-C9",
        "π C1-O2 -> lp O2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "An intramolecular Claisen: a five-membered ring closes. Five- and six-membered rings form fastest, so diethyl adipate (five-ring) and diethyl pimelate (six-ring) are the classic substrates."
    },
    {
      "stepKey": "loss-of-ethoxide",
      "stepKind": "polar",
      "toStateId": "keto-ester",
      "fromStateId": "cyclic-intermediate",
      "canonicalArrows": [
        "lp O2 -> π C1-O2",
        "σ C1-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Ethoxide leaves and the ring ketone forms: a cyclic β-keto ester."
    },
    {
      "stepKey": "deprotonation-drives-it",
      "stepKind": "polar",
      "toStateId": "stabilised-enolate",
      "fromStateId": "keto-ester",
      "canonicalArrows": [
        "lp O3 -> σ O3-H16",
        "σ C9-H16 -> π C1-C9",
        "π C1-O2 -> lp O2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "As in every Claisen, deprotonating the β-keto ester is the downhill step that drives the reaction. It needs a proton between the two C=O groups: that is why the product has one."
    },
    {
      "caption": "Ethanol is left out of the drawing. Dilute aqueous acid is added at the end (work-up).",
      "stepKey": "acid-work-up",
