{
  "steps": [
    {
      "stepKey": "n-deprotonation",
      "stepKind": "polar",
      "toStateId": "monoanion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "σ C31-Li30 -> σ C31-H4",
        "σ N3-H4 -> lp N3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The first equivalent of butyllithium removes the acidic N–H proton."
    },
    {
      "stepKey": "c-deprotonation",
      "stepKind": "polar",
      "toStateId": "dianion",
      "fromStateId": "monoanion",
      "canonicalArrows": [
        "σ C41-Li40 -> σ C41-H16",
        "σ C15-H16 -> lp C15"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The second equivalent removes an α-proton, on the less substituted side and syn to the nitrogen anion (the drawing does not show that geometry, and the app does not check it). This step decides where the alkene goes."
    },
    {
      "stepKey": "sulfinate-loss",
      "stepKind": "polar",
      "toStateId": "vinyldiazenide",
      "fromStateId": "dianion",
      "canonicalArrows": [
        "lp C15 -> π C1-C15",
        "π C1-N2 -> π N2-N3",
        "σ N3-S5 -> lp S5",
        "π S5-O6 -> lp O6"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "An elimination: the C=C forms as toluenesulfinate leaves. (The sulfinate drawn with the charge on sulfur is also accepted.)"
    },
    {
      "stepKey": "n2-loss",
      "stepKind": "polar",
      "toStateId": "vinyllithium",
      "fromStateId": "vinyldiazenide",
      "canonicalArrows": [
        "σ C1-N2 -> lp C1",
        "lp N3 -> π N2-N3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "N₂ leaves and carbon keeps the pair: a vinyllithium. It can be trapped with other electrophiles too (an aldehyde, DMF, CO₂)."
    },
    {
      "caption": "Water is added.",
      "stepKey": "water-added",
      "stepKind": "change",
      "toStateId": "vinyllithium-and-water",
      "fromStateId": "vinyllithium",
      "addedSpecies": "[H:51][O:50][H:52]",
      "routePreference": "preferred"
    },
    {
      "stepKey": "protonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "vinyllithium-and-water",
      "canonicalArrows": [
        "lp C1 -> σ C1-H51",
        "σ O50-H51 -> lp O50"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Water protonates the vinyl anion: 3-methylcyclohexene, the less substituted alkene. The Bamford–Stevens reaction would favour the more substituted 1-methylcyclohexene."
    }
  ],
