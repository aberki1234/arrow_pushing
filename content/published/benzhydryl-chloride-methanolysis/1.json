  "steps": [
    {
      "stepKey": "ionisation",
      "stepKind": "polar",
      "toStateId": "carbocation",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "σ C1-Cl2 -> lp Cl2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The positive charge is spread over both rings by resonance (onto their ortho and para carbons), so this secondary cation is about as stable as a tertiary one."
    },
    {
      "stepKey": "methanol-attacks",
      "stepKind": "polar",
      "toStateId": "oxonium-ion",
      "fromStateId": "carbocation",
      "canonicalArrows": [
        "lp O15 -> σ O15-C1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The cation is flat, so either face can be attacked. The oxygen now has three bonds and carries the positive charge."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "oxonium-ion",
      "canonicalArrows": [
        "lp O18 -> σ O18-H17",
        "σ O15-H17 -> lp O15"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Overall, OMe has replaced Cl, and HCl has formed (here as protonated methanol and chloride)."
    }
