{
  "steps": [
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "carboxylate",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N70 -> σ N70-H7",
        "σ O4-H7 -> lp O4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Hünig's base makes the carboxylate. Two or more equivalents of base are used in practice."
    },
    {
      "stepKey": "carboxylate-adds",
      "stepKind": "polar",
      "toStateId": "tetrahedral-1",
      "fromStateId": "carboxylate",
      "canonicalArrows": [
        "lp O4 -> σ O4-C80",
        "π C80-N81 -> lp N81"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The carboxylate adds to the amidinium carbon of HATU."
    },
    {
      "stepKey": "oat-leaves",
      "stepKind": "polar",
      "toStateId": "isouronium-and-oat",
      "fromStateId": "tetrahedral-1",
      "canonicalArrows": [
        "lp N81 -> π N81-C80",
        "σ C80-N87 -> π N87-N88",
        "π N88-N89 -> lp N89"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The triazole leaves as OAt⁻, with the negative charge ending on oxygen. The acid is now an O-acylisouronium ion, a very reactive acylating agent, like DCC's O-acylisourea."
    },
    {
      "stepKey": "oat-adds",
      "stepKind": "polar",
      "toStateId": "tetrahedral-2",
      "fromStateId": "isouronium-and-oat",
      "canonicalArrows": [
        "lp O90 -> σ O90-C2",
        "π C2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "OAt⁻ adds to the acyl carbon, just as OBt⁻ does in the DCC–HOBt coupling."
    },
    {
      "stepKey": "tmu-leaves",
      "stepKind": "polar",
      "toStateId": "active-ester",
      "fromStateId": "tetrahedral-2",
      "canonicalArrows": [
        "lp O3 -> π O3-C2",
        "σ C2-O4 -> π O4-C80",
        "π C80-N81 -> lp N81"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Tetramethylurea leaves, neutral, and the OAt active ester remains."
    },
    {
      "caption": "Glycine methyl ester is added. Tetramethylurea, a water-soluble by-product, is not drawn from here on.",
      "stepKey": "amine-arrives",
      "stepKind": "change",
      "toStateId": "active-ester-and-amine",
      "fromStateId": "active-ester",
      "addedSpecies": "[NH:30]([H:31])[CH2:32][C:33](=[O:34])[O:35][CH3:36]",
      "routePreference": "preferred",
      "removedFragmentMapNumbers": [
        80
      ]
    },
    {
      "stepKey": "amine-adds",
      "stepKind": "polar",
      "toStateId": "tetrahedral-3",
      "fromStateId": "active-ester-and-amine",
      "canonicalArrows": [
        "lp N30 -> σ N30-C2",
        "π C2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The amine adds to the active ester. With OAt the pyridine nitrogen sits next to the ester oxygen and hydrogen-bonds to the incoming N–H, holding the amine in place: why HATU couples faster, and with less racemisation, than HBTU (the HOBt version)."
    },
    {
      "stepKey": "oat-leaves-from-amide",
      "stepKind": "polar",
      "toStateId": "amide-and-oat",
      "fromStateId": "tetrahedral-3",
      "canonicalArrows": [
        "lp O3 -> π O3-C2",
        "σ C2-O90 -> lp O90"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "C=O re-forms and OAt⁻ leaves."
    },
    {
      "stepKey": "proton-transfer",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "amide-and-oat",
      "canonicalArrows": [
        "lp O90 -> σ O90-H31",
        "σ N30-H31 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "OAt⁻ takes the proton: the dipeptide and HOAt."
    }
  ],
