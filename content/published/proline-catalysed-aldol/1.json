{
  "steps": [
    {
      "stepKey": "amine-addition",
      "stepKind": "polar",
      "toStateId": "zwitterion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N10 -> σ N10-C2",
        "π C2-O3 -> σ O3-H15",
        "σ O14-H15 -> lp O14"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Proline is bifunctional: a secondary amine to make the enamine and a carboxylic acid to move protons. Acetone is used in large excess (20 % of the solvent), so most proline sits on acetone, not on the aldehyde."
    },
    {
      "stepKey": "nitrogen-deprotonation",
      "stepKind": "polar",
      "toStateId": "carbinolamine",
      "fromStateId": "zwitterion",
      "canonicalArrows": [
        "lp O14 -> σ O14-H20",
        "σ N10-H20 -> lp N10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The carboxylate takes the N–H proton back: the acid is ready to act again and the nitrogen has its lone pair."
    },
    {
      "stepKey": "acid-assisted-loss-of-water",
      "stepKind": "polar",
      "toStateId": "iminium",
      "fromStateId": "carbinolamine",
      "canonicalArrows": [
        "lp O3 -> σ O3-H20",
        "σ O14-H20 -> lp O14",
        "lp N10 -> π N10-C2",
        "σ C2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "General acid catalysis: the CO₂H protonates the OH just as the nitrogen pushes water out, so no strong acid is needed. Protonating first and then losing water is also accepted."
    },
    {
      "stepKey": "hydroxyl-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-carbinolamine",
      "fromStateId": "carbinolamine",
      "canonicalArrows": [
        "lp O3 -> σ O3-H20",
        "σ O14-H20 -> lp O14"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The OH becomes OH₂⁺, and water is a good leaving group."
    },
    {
      "stepKey": "loss-of-water",
      "stepKind": "polar",
      "toStateId": "iminium",
      "fromStateId": "protonated-carbinolamine",
      "canonicalArrows": [
        "lp N10 -> π N10-C2",
        "σ C2-O3 -> lp O3"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The nitrogen lone pair pushes water out, giving the iminium ion with its own carboxylate as counter-ion."
    },
    {
      "stepKey": "enamine-formation",
      "stepKind": "polar",
      "toStateId": "enamine",
      "fromStateId": "iminium",
      "canonicalArrows": [
        "lp O14 -> σ O14-H5",
        "σ C4-H5 -> π C2-C4",
        "π C2-N10 -> lp N10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The enamine is the nucleophile of enamine catalysis: its HOMO is raised by the nitrogen lone pair, much as in an enol, but it is neutral and forms at room temperature. The CO₂H is back, ready to deliver a proton."
    },
    {
      "stepKey": "aldol-addition",
      "stepKind": "polar",
      "toStateId": "aldol-iminium",
      "fromStateId": "enamine",
      "canonicalArrows": [
        "lp N10 -> π N10-C2",
        "π C2-C4 -> σ C4-C30",
        "π C30-O31 -> σ O31-H5",
        "σ O14-H5 -> lp O14"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The step that decides the enantiomer. In the Houk–List transition state the enamine is anti to the carboxylic acid, the CO₂H hydrogen-bonds to the aldehyde oxygen and delivers its proton as the C–C bond forms, and the aryl group sits pseudo-equatorial in a chair-like (Zimmerman–Traxler-like) arrangement. One face of the aldehyde is attacked: the (R)-aldol forms in 76 % ee. The app does not check stereochemistry yet, so the drawings carry no wedges and either face is accepted."
    },
    {
      "stepKey": "general-base-water-addition",
      "stepKind": "polar",
      "toStateId": "carbinolamine-2",
      "fromStateId": "aldol-iminium",
      "canonicalArrows": [
        "lp O14 -> σ O14-H15",
        "σ O3-H15 -> lp O3",
        "lp O3 -> σ O3-C2",
        "π C2-N10 -> lp N10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "General base catalysis: the carboxylate takes a proton from water as water adds, so no OH₂⁺ builds up. Adding water first and then moving the proton is also accepted."
    },
    {
      "stepKey": "water-addition",
      "stepKind": "polar",
      "toStateId": "water-adduct",
      "fromStateId": "aldol-iminium",
      "canonicalArrows": [
        "lp O3 -> σ O3-C2",
        "π C2-N10 -> lp N10"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Water adds to the C=N⁺ carbon."
    },
    {
      "stepKey": "proton-to-carboxylate",
      "stepKind": "polar",
      "toStateId": "carbinolamine-2",
      "fromStateId": "water-adduct",
      "canonicalArrows": [
        "lp O14 -> σ O14-H15",
        "σ O3-H15 -> lp O3"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The carboxylate takes a proton off the new OH₂⁺ group."
    },
    {
      "stepKey": "nitrogen-protonation",
      "stepKind": "polar",
      "toStateId": "ammonium",
      "fromStateId": "carbinolamine-2",
      "canonicalArrows": [
        "lp N10 -> σ N10-H15",
        "σ O14-H15 -> lp O14"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The proton moves on to nitrogen, turning proline into a leaving group."
    },
    {
      "stepKey": "proline-release",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "ammonium",
      "canonicalArrows": [
        "lp O14 -> σ O14-H20",
        "σ O3-H20 -> π C2-O3",
        "σ C2-N10 -> lp N10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The ketone re-forms and proline leaves with its acid restored: the catalyst turns over. 30 mol % proline was used, and 4-nitrobenzaldehyde gave the aldol in 68 % yield."
    }
  ],
