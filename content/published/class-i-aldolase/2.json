{
  "steps": [
    {
      "stepKey": "enamine-formation",
      "stepKind": "polar",
      "toStateId": "enamine",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O44 -> σ O44-H5",
        "σ C3-H5 -> π C2-C3",
        "π C2-N11 -> lp N11"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The iminium ion is a better electron sink than a ketone, so the C–H next to it is easily removed. The enamine is the enzyme's version of an enol: nucleophilic at carbon."
    },
    {
      "stepKey": "aldol-addition",
      "stepKind": "polar",
      "toStateId": "alkoxide",
      "fromStateId": "enamine",
      "canonicalArrows": [
        "lp N11 -> π C2-N11",
        "π C2-C3 -> σ C3-C21",
        "π C21-O22 -> lp O22"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The new C–C bond joins two three-carbon sugars into a six-carbon sugar. The enzyme holds the aldehyde so that one face is attacked: fructose 1,6-bisphosphate is formed as a single stereoisomer (3S,4R). The app does not check stereochemistry yet."
    },
    {
      "stepKey": "aldol-with-protonation",
      "stepKind": "polar",
      "toStateId": "product-iminium",
      "fromStateId": "enamine",
      "canonicalArrows": [
        "lp N11 -> π C2-N11",
        "π C2-C3 -> σ C3-C21",
        "π C21-O22 -> σ O22-H5",
        "σ O44-H5 -> lp O44"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct, and closer to the enzyme: an acidic group protonates the aldehyde oxygen as the C–C bond forms (general acid catalysis), so no free alkoxide is made."
    },
    {
      "stepKey": "alkoxide-protonation",
      "stepKind": "polar",
      "toStateId": "product-iminium",
      "fromStateId": "alkoxide",
      "canonicalArrows": [
        "lp O22 -> σ O22-H5",
        "σ O44-H5 -> lp O44"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A proton transfer. The product is still bound to lysine; hydrolysis of the iminium ion releases it."
    },
    {
      "stepKey": "water-adds",
      "stepKind": "polar",
      "toStateId": "carbinolamine",
      "fromStateId": "product-iminium",
      "canonicalArrows": [
        "lp O44 -> σ O44-H51",
        "σ O52-H51 -> σ O52-C2",
        "π C2-N11 -> lp N11"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Hydrolysis is imine formation in reverse: water adds to the C=N⁺ carbon."
    },
    {
      "stepKey": "nitrogen-protonation",
      "stepKind": "polar",
      "toStateId": "carbinolammonium",
      "fromStateId": "carbinolamine",
      "canonicalArrows": [
        "lp N11 -> σ N11-H51",
        "σ O44-H51 -> lp O44"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Protonation turns the nitrogen into a good leaving group: a neutral amine."
    },
    {
      "stepKey": "lysine-leaves",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "carbinolammonium",
      "canonicalArrows": [
        "lp O44 -> σ O44-H53",
        "σ O52-H53 -> π C2-O52",
        "σ C2-N11 -> lp N11"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The ketone re-forms and lysine is free for the next turn. Run backwards, these steps are the retro-aldol that splits fructose 1,6-bisphosphate in glycolysis."
    }
  ],
