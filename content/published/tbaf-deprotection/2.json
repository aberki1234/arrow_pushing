{
  "steps": [
    {
      "stepKey": "fluoride-adds-to-silicon",
      "stepKind": "polar",
      "toStateId": "silicate",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp F40 -> σ F40-Si10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Fluoride adds to silicon: a five-coordinate, negatively charged silicate, roughly trigonal bipyramidal. Silicon can do this because it is large and its σ* orbitals are low in energy; a carbon with five bonds would only be a transition state."
    },
    {
      "stepKey": "alkoxide-leaves",
      "stepKind": "polar",
      "toStateId": "alkoxide",
      "fromStateId": "silicate",
      "canonicalArrows": [
        "σ O1-Si10 -> lp O1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The alkoxide leaves from the silicate. The new Si–F bond is about 120 kJ mol⁻¹ stronger than the Si–O bond broken: that is the driving force."
    },
    {
      "stepKey": "concerted-substitution",
      "stepKind": "polar",
      "toStateId": "alkoxide",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp F40 -> σ F40-Si10",
        "σ O1-Si10 -> lp O1"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also accepted: substitution at silicon drawn in one step. Whether the five-coordinate silicate is an intermediate or only a transition state depends on the groups on silicon; with fluoride it is usually drawn as an intermediate."
    },
    {
      "caption": "Aqueous ammonium chloride work-up",
      "stepKey": "workup",
      "stepKind": "change",
      "toStateId": "alkoxide-and-workup",
      "fromStateId": "alkoxide",
      "addedSpecies": "[H:61][NH3+:60].[Cl-:62]",
      "routePreference": "preferred"
    },
    {
      "stepKey": "protonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "alkoxide-and-workup",
      "canonicalArrows": [
        "lp O1 -> σ O1-H61",
        "σ N60-H61 -> lp N60"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The alkoxide takes a proton: the diol is free again. In the dry THF solution before work-up the alkoxide is quite basic, which is why TBAF is sometimes buffered with acetic acid for base-sensitive molecules."
    }
  ],
