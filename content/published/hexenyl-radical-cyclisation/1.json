{
  "steps": [
    {
      "stepKey": "bromine-abstraction",
      "stepKind": "radical",
      "toStateId": "hexenyl-radical",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "rad Sn12 ~> σ Sn12-Br7",
        "σ Br7-C6 ~> σ Sn12-Br7",
        "σ Br7-C6 ~> rad C6"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Bu₃Sn• abstracts bromine: the Sn–Br bond formed is stronger than the C–Br bond broken. A primary radical is left at the end of the chain."
    },
    {
      "stepKey": "five-exo-cyclisation",
      "stepKind": "radical",
      "toStateId": "cyclopentylmethyl-radical",
      "fromStateId": "hexenyl-radical",
      "canonicalArrows": [
        "rad C6 ~> σ C6-C2",
        "π C2-C1 ~> σ C6-C2",
        "π C2-C1 ~> rad C1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "5-exo-trig: the radical attacks the near end of the alkene, and the new radical sits outside (exo) the five-membered ring. It is fast (about 10⁵ s⁻¹) and wins over 6-endo by about 50:1, although 6-endo would give a more stable secondary radical: in the chair-like transition state only the near alkene carbon can be reached along the line (about 107°) at which the radical must approach the π bond. Baldwin's rules allow both closures; 5-exo simply wins on rate."
    },
    {
      "stepKey": "six-endo-cyclisation",
      "stepKind": "radical",
      "toStateId": "cyclohexyl-radical",
      "fromStateId": "hexenyl-radical",
      "canonicalArrows": [
        "rad C6 ~> σ C6-C1",
        "π C1-C2 ~> σ C6-C1",
        "π C1-C2 ~> rad C2"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct, but minor (about 2%): attack at the far end of the alkene gives a six-membered ring with the radical inside it (6-endo). The secondary radical is more stable, but the geometry of approach to the far carbon is poor, so this closure is about 50 times slower than 5-exo."
    },
    {
      "stepKey": "hydrogen-transfer",
      "stepKind": "radical",
      "toStateId": "methylcyclopentane",
      "fromStateId": "cyclopentylmethyl-radical",
      "canonicalArrows": [
        "rad C1 ~> σ C1-H26",
        "σ H26-Sn25 ~> σ C1-H26",
        "σ H26-Sn25 ~> rad Sn25"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The cyclised radical takes H from Bu₃SnH, giving methylcyclopentane and a new Bu₃Sn• to continue the chain."
    },
    {
      "stepKey": "hydrogen-transfer-cyclohexyl",
      "stepKind": "radical",
      "toStateId": "cyclohexane",
      "fromStateId": "cyclohexyl-radical",
      "canonicalArrows": [
        "rad C2 ~> σ C2-H26",
        "σ H26-Sn25 ~> σ C2-H26",
        "σ H26-Sn25 ~> rad Sn25"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The cyclohexyl radical takes H from tin in the same way, giving the minor product, cyclohexane."
    }
  ],
