{
  "steps": [
    {
      "stepKey": "amine-adds",
      "stepKind": "polar",
      "toStateId": "tetrahedral",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N1 -> σ N1-C15",
        "π C15-O16 -> lp O16"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The amine adds to a C=O of Boc₂O, as to any anhydride. The OH of 2-aminoethanol is left alone: an amine nitrogen is a much better nucleophile than an alcohol oxygen."
    },
    {
      "stepKey": "collapse",
      "stepKind": "polar",
      "toStateId": "carbamate-and-carbonate",
      "fromStateId": "tetrahedral",
      "canonicalArrows": [
        "lp O16 -> π O16-C15",
        "σ C15-O17 -> lp O17"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "C=O re-forms and the tert-butyl carbonate anion leaves. The new C–N bond makes a carbamate: the nitrogen lone pair is now delocalised into the C=O, so the nitrogen is no longer basic or nucleophilic."
    },
    {
      "stepKey": "lose-co2",
      "stepKind": "polar",
      "toStateId": "tert-butoxide",
      "fromStateId": "carbamate-and-carbonate",
      "canonicalArrows": [
        "lp O17 -> π O17-C18",
        "σ C18-O20 -> lp O20"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The carbonate anion falls apart into CO₂ and tert-butoxide. Loss of CO₂ gas makes the reaction irreversible."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "tert-butoxide",
      "canonicalArrows": [
        "lp O20 -> σ O20-H2",
        "σ N1-H2 -> lp N1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "tert-Butoxide removes the proton: the Boc carbamate, CO₂ and tert-butanol. No added base is needed, though triethylamine or aqueous NaOH is often used to keep the amine free of acid."
    }
  ],
