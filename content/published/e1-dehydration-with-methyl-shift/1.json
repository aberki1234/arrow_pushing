  "steps": [
    {
      "stepKey": "protonation",
      "stepKind": "polar",
      "toStateId": "oxonium-ion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O3 -> σ O3-H8",
        "σ O9-H8 -> lp O9"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The OH group is now OH₂⁺, which can leave as neutral water."
    },
    {
      "stepKey": "loss-of-water",
      "stepKind": "polar",
      "toStateId": "secondary-cation",
      "fromStateId": "oxonium-ion",
      "canonicalArrows": [
        "σ C2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Water leaves and a secondary carbocation forms. It is next to a carbon carrying three methyl groups."
    },
    {
      "stepKey": "loss-of-water-with-methyl-shift",
      "stepKind": "polar",
      "toStateId": "tertiary-cation",
      "fromStateId": "oxonium-ion",
      "canonicalArrows": [
        "σ C2-O3 -> lp O3",
        "σ C4-C5 -> σ C2-C5"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct: the methyl group shifts as water leaves, so the secondary cation is never free. Textbooks usually draw the two steps separately."
    },
    {
      "stepKey": "methyl-shift",
      "stepKind": "polar",
      "toStateId": "tertiary-cation",
      "fromStateId": "secondary-cation",
      "canonicalArrows": [
        "σ C4-C5 -> σ C2-C5"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A 1,2-methyl shift: the methyl moves with its bonding pair to the empty p orbital next door. The new cation is tertiary, stabilised by three alkyl groups, so the shift is downhill."
    },
    {
      "stepKey": "deprotonation-to-tetrasubstituted",
      "stepKind": "polar",
      "toStateId": "tetrasubstituted-alkene",
      "fromStateId": "tertiary-cation",
      "canonicalArrows": [
        "lp O9 -> σ O9-H14",
        "σ C2-H14 -> π C2-C4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The C=C bond carries four methyl groups: the most stable alkene possible here (Zaitsev)."
    },
    {
      "stepKey": "deprotonation-to-disubstituted",
      "stepKind": "polar",
      "toStateId": "disubstituted-alkene",
      "fromStateId": "tertiary-cation",
      "canonicalArrows": [
        "lp O9 -> σ O9-H15",
        "σ C6-H15 -> π C4-C6"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct: losing a methyl hydrogen gives 2,3-dimethylbut-1-ene, the minor product. Its C=C bond carries only two alkyl groups."
    }
  ],
