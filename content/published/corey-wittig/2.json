{
  "steps": [
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "lactol-anion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp C80 -> σ C80-H19",
        "σ O1-H19 -> lp O1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Dimsyl takes the lactol O–H proton. A lactol alkoxide is a hemiacetal anion and opens easily."
    },
    {
      "stepKey": "ring-opening",
      "stepKind": "polar",
      "toStateId": "hydroxy-aldehyde",
      "fromStateId": "lactol-anion",
      "canonicalArrows": [
        "lp O1 -> π C2-O1",
        "σ C2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The ring opens to the aldehyde and an alkoxide on the cyclopentane. The ring-closed and ring-open forms are in equilibrium; the ylide draws it towards the aldehyde."
    },
    {
      "stepKey": "cycloaddition",
      "stepKind": "polar",
      "toStateId": "oxaphosphetane",
      "fromStateId": "hydroxy-aldehyde",
      "canonicalArrows": [
        "lp C30 -> σ C2-C30",
        "π C2-O1 -> σ O1-P31"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Under salt-free conditions the ylide and the aldehyde form the oxaphosphetane directly. With an unstabilised ylide the ring forms fast and irreversibly, by the less hindered approach that puts the two chains cis: this is where the (Z) geometry of the final alkene is decided (not checked by the app yet)."
    },
    {
      "stepKey": "betaine-formation",
      "stepKind": "polar",
      "toStateId": "betaine",
      "fromStateId": "hydroxy-aldehyde",
      "canonicalArrows": [
        "lp C30 -> σ C2-C30",
        "π C2-O1 -> lp O1"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct: the addition drawn as a separate step, giving a betaine. The textbook now draws the oxaphosphetane forming in one step."
    },
    {
      "stepKey": "betaine-ring-closure",
      "stepKind": "polar",
      "toStateId": "oxaphosphetane",
      "fromStateId": "betaine",
      "canonicalArrows": [
        "lp O1 -> σ O1-P31"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The alkoxide bonds to phosphorus: the oxaphosphetane."
    },
    {
      "stepKey": "cycloreversion",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "oxaphosphetane",
      "canonicalArrows": [
        "σ P31-C30 -> π C2-C30",
        "σ C2-O1 -> π O1-P31"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The oxaphosphetane falls apart to the alkene and triphenylphosphine oxide. The ring's cis geometry becomes the (Z)-alkene: the cis double bond of the prostaglandin's upper chain."
    }
  ],
