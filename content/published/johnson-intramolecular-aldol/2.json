{
  "steps": [
    {
      "stepKey": "enolate-formation",
      "stepKind": "polar",
      "toStateId": "enolate",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O40 -> σ O40-H30",
        "σ C4-H30 -> π C3-C4",
        "π C3-O22 -> lp O22"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Every enolate forms reversibly. Only this one, from the methyl group made by ozonolysis, can close a six-membered ring onto the B-ring ketone, so the product comes through it. The other enolates would close strained, bridged or large rings."
    },
    {
      "stepKey": "ring-closure",
      "stepKind": "polar",
      "toStateId": "alkoxide",
      "fromStateId": "enolate",
      "canonicalArrows": [
        "lp O22 -> π C3-O22",
        "π C3-C4 -> σ C4-C5",
        "π C5-O23 -> lp O23"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "An intramolecular aldol: the new six-membered ring is ring A of the steroid. The angular methyl group next door is untouched."
    },
    {
      "stepKey": "alkoxide-protonation",
      "stepKind": "polar",
      "toStateId": "aldol",
      "fromStateId": "alkoxide",
      "canonicalArrows": [
        "lp O23 -> σ O23-H30",
        "σ O40-H30 -> lp O40"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Water protonates the alkoxide, giving the β-hydroxy ketone and hydroxide again."
    },
    {
      "stepKey": "enolate-for-elimination",
      "stepKind": "polar",
      "toStateId": "second-enolate",
      "fromStateId": "aldol",
      "canonicalArrows": [
        "lp O40 -> σ O40-H31",
        "σ C4-H31 -> π C3-C4",
        "π C3-O22 -> lp O22"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "This enolate sits next to the carbon carrying OH, ready for E1cB."
    },
    {
      "stepKey": "loss-of-hydroxide",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "second-enolate",
      "canonicalArrows": [
        "lp O22 -> π C3-O22",
        "π C3-C4 -> π C4-C5",
        "σ C5-O23 -> lp O23"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "E1cB: hydroxide leaves and the C=C forms in conjugation with the C=O. The conjugated cyclohexenone is ring A of progesterone, and Johnson's synthesis is complete."
    }
  ],
