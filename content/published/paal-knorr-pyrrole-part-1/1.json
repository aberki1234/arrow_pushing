{
  "steps": [
    {
      "stepKey": "amine-addition",
      "stepKind": "polar",
      "toStateId": "zwitterion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N9 -> σ N9-C2",
        "π C2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The first step of every imine or enamine formation: the amine adds to the carbonyl group. The two ketones are identical, so it does not matter which one is attacked."
    },
    {
      "stepKey": "oxygen-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-adduct",
      "fromStateId": "zwitterion",
      "canonicalArrows": [
        "lp O3 -> σ O3-H17",
        "σ O16-H17 -> lp O16"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Acetic acid protonates the alkoxide."
    },
    {
      "stepKey": "nitrogen-deprotonation",
      "stepKind": "polar",
      "toStateId": "hemiaminal",
      "fromStateId": "protonated-adduct",
      "canonicalArrows": [
        "lp O16 -> σ O16-H11",
        "σ N9-H11 -> lp N9"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Acetate removes a proton from nitrogen. Together, these two proton transfers move a proton from N to O: the result is a hemiaminal with a free lone pair on nitrogen."
    },
    {
      "stepKey": "ring-closure",
      "stepKind": "polar",
      "toStateId": "cyclic-zwitterion",
      "fromStateId": "hemiaminal",
      "canonicalArrows": [
        "lp N9 -> σ N9-C6",
        "π C6-O7 -> lp O7"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A five-membered ring forms easily: the nitrogen and the second carbonyl carbon are held close together. This is the slow step of the Paal–Knorr synthesis."
    },
    {
      "stepKey": "second-oxygen-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-ring",
      "fromStateId": "cyclic-zwitterion",
      "canonicalArrows": [
        "lp O7 -> σ O7-H11",
        "σ O16-H11 -> lp O16"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Acetic acid protonates the second alkoxide."
    },
    {
      "stepKey": "second-nitrogen-deprotonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "protonated-ring",
      "canonicalArrows": [
        "lp O16 -> σ O16-H12",
        "σ N9-H12 -> lp N9"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Acetate removes the N–H proton, giving a neutral cyclic bis-hemiaminal. Losing two molecules of water from it gives the aromatic pyrrole: that is Part 2."
    }
  ],
