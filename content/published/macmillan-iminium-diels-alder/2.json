{
  "steps": [
    {
      "stepKey": "amine-addition",
      "stepKind": "polar",
      "toStateId": "ammonium-adduct",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N40 -> σ N40-C1",
        "π C1-O2 -> σ O2-H61",
        "σ O60-H61 -> lp O60"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "MacMillan's catalyst is a secondary amine made from phenylalanine. Its acid co-catalyst (HCl) speeds up iminium formation; the amide nitrogen in the ring is not nucleophilic."
    },
    {
      "stepKey": "nitrogen-deprotonation",
      "stepKind": "polar",
      "toStateId": "carbinolamine",
      "fromStateId": "ammonium-adduct",
      "canonicalArrows": [
        "lp O60 -> σ O60-H50",
        "σ N40-H50 -> lp N40"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Water takes the N–H proton, so the nitrogen has its lone pair again."
    },
    {
      "stepKey": "acid-assisted-loss-of-water",
      "stepKind": "polar",
      "toStateId": "iminium",
      "fromStateId": "carbinolamine",
      "canonicalArrows": [
        "lp O2 -> σ O2-H50",
        "σ O60-H50 -> lp O60",
        "lp N40 -> π N40-C1",
        "σ C1-O2 -> lp O2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The iminium ion forms. Its positive charge lowers the LUMO of the C=C, just as a Lewis acid on the C=O would: this is LUMO-lowering catalysis. The geminal methyl groups make the (E)-iminium the only one that forms."
    },
    {
      "stepKey": "diels-alder",
      "stepKind": "polar",
      "toStateId": "cycloadduct",
      "fromStateId": "iminium",
      "canonicalArrows": [
        "π C11-C12 -> σ C4-C11",
        "π C13-C14 -> π C12-C13",
        "π C3-C4 -> σ C3-C14"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A concerted [4+2] cycloaddition makes the bicyclo[2.2.1]heptene. The benzyl group of the catalyst shields one face of the iminium C=C, so cyclopentadiene adds to the other face: the exo adduct forms in 93 % ee. Exo and endo form in about 1.3 : 1 here, so the iminium route gives little endo preference. The app does not check stereochemistry yet, so the drawings carry no wedges and either face is accepted."
    },
    {
      "stepKey": "general-base-water-addition",
      "stepKind": "polar",
      "toStateId": "carbinolamine-2",
      "fromStateId": "cycloadduct",
      "canonicalArrows": [
        "lp O60 -> σ O60-H61",
        "σ O2-H61 -> lp O2",
        "lp O2 -> σ O2-C1",
        "π C1-N40 -> lp N40"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Hydrolysis starts: the solvent contains 5 % water, needed to turn the catalyst over. A second water takes a proton as the first adds."
    },
    {
      "stepKey": "nitrogen-protonation",
      "stepKind": "polar",
      "toStateId": "ammonium",
      "fromStateId": "carbinolamine-2",
      "canonicalArrows": [
        "lp N40 -> σ N40-H61",
        "σ O60-H61 -> lp O60"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "H₃O⁺ protonates the nitrogen, turning the catalyst into a leaving group."
    },
    {
      "stepKey": "catalyst-release",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "ammonium",
      "canonicalArrows": [
        "lp O60 -> σ O60-H50",
        "σ O2-H50 -> π C1-O2",
        "σ C1-N40 -> lp N40"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The aldehyde re-forms and the amine leaves: 5 mol % of catalyst gives the adducts in 99 % yield."
    }
  ],
