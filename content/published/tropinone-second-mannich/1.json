{
  "steps": [
    {
      "stepKey": "ketone-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-ketone",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O19 -> σ O19-H26",
        "σ O25-H26 -> lp O25"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Enolisation starts again, this time towards the other α-carbon."
    },
    {
      "stepKey": "enol-formation",
      "stepKind": "polar",
      "toStateId": "enol",
      "fromStateId": "protonated-ketone",
      "canonicalArrows": [
        "lp O27 -> σ O27-H29",
        "σ C20-H29 -> π C18-C20",
        "π C18-O19 -> lp O19"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "This enol points its nucleophilic carbon at the side of the molecule that still carries the masked iminium ion. The other α-carbon, now joined to the ring, could also enolise, but its enol cannot close a ring."
    },
    {
      "stepKey": "hydroxyl-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-hemiaminal",
      "fromStateId": "enol",
      "canonicalArrows": [
        "lp O6 -> σ O6-H29",
        "σ O27-H29 -> lp O27"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Protonated, the hemiaminal OH can leave as water, exactly as in the first iminium ion."
    },
    {
      "stepKey": "second-iminium",
      "stepKind": "polar",
      "toStateId": "iminium-and-enol",
      "fromStateId": "protonated-hemiaminal",
      "canonicalArrows": [
        "lp N7 -> π N7-C5",
        "σ C5-O6 -> lp O6"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The second iminium ion forms on the other carbon next to nitrogen. Nucleophile and electrophile are now held close together in one molecule."
    },
    {
      "stepKey": "second-mannich",
      "stepKind": "polar",
      "toStateId": "oxocarbenium",
      "fromStateId": "iminium-and-enol",
      "canonicalArrows": [
        "lp O19 -> π C18-O19",
        "π C18-C20 -> σ C5-C20",
        "π C5-N7 -> lp N7"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "An intramolecular Mannich reaction closes a six-membered ring across the pyrrolidine: the bicyclic tropane skeleton. The new bond can only form on the same face as the first, so the nitrogen bridges two cis ring-junction carbons; the app does not check stereochemistry yet."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "oxocarbenium",
      "canonicalArrows": [
        "lp O25 -> σ O25-H26",
        "σ O19-H26 -> lp O19"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Loss of the proton gives tropinone-2,4-dicarboxylic acid. Two Mannich reactions have made two C–C bonds and the whole bicyclic skeleton from three simple pieces."
    }
  ],
