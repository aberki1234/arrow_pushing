{
  "steps": [
    {
      "stepKey": "cation-pi-cascade",
      "stepKind": "polar",
      "toStateId": "vinyl-cation",
      "fromStateId": "allylic-cation",
      "canonicalArrows": [
        "π C8-C9 -> σ C9-C10",
        "π C13-C14 -> σ C8-C14",
        "π C17-C20 -> σ C13-C17"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Three C–C bonds and three rings (B, C and D) in one step. The chain folds like a chair–chair, so every new ring fusion is trans and the product has the natural all-trans steroid backbone; the trans double bonds of the chain fix that geometry. The app does not check stereochemistry yet. Each closure makes the positive charge on the carbon the next π bond can reach, and the alkyne ends it with a linear vinyl cation outside the five-membered D ring."
    },
    {
      "stepKey": "first-ring",
      "stepKind": "polar",
      "toStateId": "secondary-cation",
      "fromStateId": "allylic-cation",
      "canonicalArrows": [
        "π C8-C9 -> σ C9-C10"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Correct, one ring at a time. Whether the cascade is fully concerted or a series of very fast steps is still discussed; the secondary cation would barely exist before the next alkene caught it."
    },
    {
      "stepKey": "second-ring",
      "stepKind": "polar",
      "toStateId": "tertiary-cation",
      "fromStateId": "secondary-cation",
      "canonicalArrows": [
        "π C13-C14 -> σ C8-C14"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The second six-membered ring, and the cation becomes tertiary."
    },
    {
      "stepKey": "third-ring",
      "stepKind": "polar",
      "toStateId": "vinyl-cation",
      "fromStateId": "tertiary-cation",
      "canonicalArrows": [
        "π C17-C20 -> σ C13-C17"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The alkyne terminates the cascade: a five-membered ring and a linear vinyl cation."
    },
    {
      "stepKey": "vinyl-cation-capture",
      "stepKind": "polar",
      "toStateId": "trapped",
      "fromStateId": "vinyl-cation",
      "canonicalArrows": [
        "lp O40 -> σ O40-C20"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Ethylene carbonate is a weak nucleophile that does not interfere with the cascade but catches the reactive vinyl cation at the end. In the work-up (aqueous potassium carbonate in methanol) the adduct is hydrolysed to the enol, which tautomerises to the methyl ketone: the acetyl group of progesterone."
    }
  ],
