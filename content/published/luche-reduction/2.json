{
  "steps": [
    {
      "stepKey": "cerium-binds-oxygen",
      "stepKind": "polar",
      "toStateId": "cerium-complex",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O1 -> σ O1-Ce10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Ce³⁺ binds the carbonyl oxygen. That puts more positive charge on the carbonyl carbon, the hard end of the enone."
    },
    {
      "stepKey": "hydride-transfer",
      "stepKind": "polar",
      "toStateId": "cerium-alkoxide",
      "fromStateId": "cerium-complex",
      "canonicalArrows": [
        "σ B21-H22 -> σ C2-H22",
        "π C2-O1 -> lp O1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Hydride adds 1,2, straight to the carbonyl carbon. Cerium also helps methanol replace hydrides on boron, making harder methoxyborohydrides that prefer the C=O carbon too. The C=C survives."
    },
    {
      "stepKey": "protonolysis",
      "stepKind": "polar",
      "toStateId": "alcohol",
      "fromStateId": "cerium-alkoxide",
      "canonicalArrows": [
        "σ O1-Ce10 -> σ O1-H24",
        "σ O23-H24 -> lp O23"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Methanol protonates the oxygen as it leaves cerium: the allylic alcohol, and CeCl₃ is free again."
    },
    {
      "stepKey": "methoxide-captures-borane",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "alcohol",
      "canonicalArrows": [
        "lp O23 -> σ B21-O23"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Methoxide bonds to BH₃, giving a methoxyborohydride that can reduce more enone."
    }
  ],
