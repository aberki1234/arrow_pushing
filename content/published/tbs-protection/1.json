{
  "steps": [
    {
      "stepKey": "imidazole-attacks-silicon",
      "stepKind": "polar",
      "toStateId": "silylimidazolium",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N21 -> σ N21-Si10",
        "σ Si10-Cl17 -> lp Cl17"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Imidazole displaces chloride from silicon. Substitution at silicon is easy even with three groups on it: Si–C and Si–O bonds are long (about 1.9 and 1.65 Å), so the nucleophile can reach in, and silicon can briefly hold five groups. The app draws it as one step here; the next reaction shows the five-coordinate silicon on its own."
    },
    {
      "stepKey": "alcohol-attacks-silicon",
      "stepKind": "polar",
      "toStateId": "silyloxonium",
      "fromStateId": "silylimidazolium",
      "canonicalArrows": [
        "lp O1 -> σ O1-Si10",
        "σ Si10-N21 -> lp N21"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The primary alcohol displaces imidazole: imidazole was a nucleophilic catalyst, in and out again, like DMAP in acylations. The bulky tert-butyl group on silicon makes the hindered secondary OH react much more slowly."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "silyloxonium",
      "canonicalArrows": [
        "lp N31 -> σ N31-H7",
        "σ O1-H7 -> lp O1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The second imidazole takes the proton: the TBS ether and imidazolium chloride. That is why two equivalents of imidazole are used."
    }
  ],
