{
  "steps": [
    {
      "stepKey": "protonation",
      "stepKind": "polar",
      "toStateId": "oxonium-ion",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O3 -> σ O3-H9",
        "σ H9-Br10 -> lp Br10"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The OH becomes OH₂⁺, a good leaving group."
    },
    {
      "stepKey": "loss-of-water",
      "stepKind": "polar",
      "toStateId": "secondary-cation",
      "fromStateId": "oxonium-ion",
      "canonicalArrows": [
        "σ C2-O3 -> lp O3"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Water leaves: a secondary carbocation right next to a strained four-membered ring."
    },
    {
      "stepKey": "loss-of-water-with-ring-expansion",
      "stepKind": "polar",
      "toStateId": "cyclopentyl-cation",
      "fromStateId": "oxonium-ion",
      "canonicalArrows": [
        "σ C2-O3 -> lp O3",
        "σ C4-C5 -> σ C2-C5"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct: the ring bond can move as water leaves, so the secondary cation next to the ring never has to form."
    },
    {
      "stepKey": "ring-expansion",
      "stepKind": "polar",
      "toStateId": "cyclopentyl-cation",
      "fromStateId": "secondary-cation",
      "canonicalArrows": [
        "σ C4-C5 -> σ C2-C5"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A ring C–C bond moves to the cationic carbon, which becomes part of the ring: four-membered becomes five-membered. The cation is still secondary, but most of the ring strain has gone, and that drives the shift."
    },
    {
      "stepKey": "hydride-shift",
      "stepKind": "polar",
      "toStateId": "tertiary-cation",
      "fromStateId": "cyclopentyl-cation",
      "canonicalArrows": [
        "σ C2-H8 -> σ C4-H8"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A 1,2-hydride shift turns the secondary cation into a tertiary one."
    },
    {
      "stepKey": "bromide-adds",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "tertiary-cation",
      "canonicalArrows": [
        "lp Br10 -> σ Br10-C2"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Bromide traps the tertiary cation: 1-bromo-1-methylcyclopentane. With less nucleophile, loss of a proton would give 1-methylcyclopentene instead."
    },
    {
      "stepKey": "bromide-adds-before-hydride-shift",
      "stepKind": "polar",
      "toStateId": "secondary-bromide",
      "fromStateId": "cyclopentyl-cation",
      "canonicalArrows": [
        "lp Br10 -> σ Br10-C4"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also possible, but minor: bromide can trap the secondary cation before the hydride shift, giving 1-bromo-2-methylcyclopentane."
    }
  ],
