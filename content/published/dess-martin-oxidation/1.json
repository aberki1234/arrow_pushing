{
  "steps": [
    {
      "stepKey": "ligand-exchange",
      "stepKind": "polar",
      "toStateId": "alkoxy-oxonium",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp O32 -> σ O32-I1",
        "σ I1-O11 -> lp O11"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The alcohol replaces an acetate on iodine. Iodine keeps five bonds and a lone pair: twelve electrons, which elements below the second row can hold."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "alkoxyperiodinane",
      "fromStateId": "alkoxy-oxonium",
      "canonicalArrows": [
        "lp O11 -> σ O11-H33",
        "σ O32-H33 -> lp O32"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The released acetate takes the proton: acetic acid. The alcohol is now an alkoxy group on iodine."
    },
    {
      "stepKey": "acetate-leaves",
      "stepKind": "polar",
      "toStateId": "iodonium",
      "fromStateId": "alkoxyperiodinane",
      "canonicalArrows": [
        "σ I1-O15 -> lp O15"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "A second acetate leaves iodine. This is one simple way to draw where the base comes from; the order of these small steps is not known for certain."
    },
    {
      "stepKey": "oxidation",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "iodonium",
      "canonicalArrows": [
        "lp O15 -> σ O15-H31",
        "σ C30-H31 -> π C30-O32",
        "σ O32-I1 -> lp I1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Acetate removes the hydrogen on the alcohol carbon, the C=O forms and the O–I pair goes to iodine: iodine(V) is reduced to iodine(III), the alcohol oxidised to the aldehyde. It is the same pattern as the Swern's last step."
    }
  ],
