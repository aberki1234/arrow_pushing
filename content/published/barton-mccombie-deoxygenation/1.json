{
  "steps": [
    {
      "stepKey": "tin-adds-to-sulfur",
      "stepKind": "radical",
      "toStateId": "stannyl-adduct",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "rad Sn12 ~> σ Sn12-S9",
        "π S9-C8 ~> σ Sn12-S9",
        "π S9-C8 ~> rad C8"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Tin radicals are thiophilic: the Sn–S bond is strong and the C=S π bond weak. The carbon radical formed is stabilised by the oxygen and both sulfur atoms."
    },
    {
      "stepKey": "beta-scission",
      "stepKind": "radical",
      "toStateId": "cyclohexyl-radical",
      "fromStateId": "stannyl-adduct",
      "canonicalArrows": [
        "rad C8 ~> π C8-O7",
        "σ C1-O7 ~> π C8-O7",
        "σ C1-O7 ~> rad C1"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "β-Scission: the bond one atom away from the radical breaks, making a C=O. Swapping a C=S for a much stronger C=O drives it. The C–O bond to the alcohol carbon is the one that breaks."
    },
    {
      "stepKey": "hydrogen-transfer",
      "stepKind": "radical",
      "toStateId": "products",
      "fromStateId": "cyclohexyl-radical",
      "canonicalArrows": [
        "rad C1 ~> σ C1-H26",
        "σ H26-Sn25 ~> σ C1-H26",
        "σ H26-Sn25 ~> rad Sn25"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The cyclohexyl radical takes H from Bu₃SnH. The new Bu₃Sn• attacks the next xanthate: a chain. Overall C–OH has become C–H."
    }
  ],
