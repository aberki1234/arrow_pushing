{
  "steps": [
    {
      "stepKey": "ring-closing-aldol",
      "stepKind": "polar",
      "toStateId": "iminium-ketol",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp N30 -> π N30-C12",
        "π C12-C14 -> σ C1-C14",
        "π C1-O2 -> σ O2-H15",
        "σ O34-H15 -> lp O34"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "This is the step that decides the hand of the product. The two ring carbonyls are mirror images; in the chair-like transition state the CO₂H of (S)-proline hydrogen-bonds to one of them and delivers its proton as the C–C bond forms (the Houk–List model), so one carbonyl is attacked much faster than the other. The quaternary methyl carbon becomes a stereocentre of one configuration, giving the (S)-ketone in about 70 % ee. The app does not check stereochemistry yet: both carbonyls are accepted here."
    },
    {
      "stepKey": "water-addition",
      "stepKind": "polar",
      "toStateId": "water-adduct",
      "fromStateId": "iminium-ketol",
      "canonicalArrows": [
        "lp O13 -> σ O13-C12",
        "π C12-N30 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Hydrolysis is iminium formation run backwards: water adds to the C=N⁺ carbon."
    },
    {
      "stepKey": "proton-to-carboxylate",
      "stepKind": "polar",
      "toStateId": "carbinolamine",
      "fromStateId": "water-adduct",
      "canonicalArrows": [
        "lp O34 -> σ O34-H35",
        "σ O13-H35 -> lp O13"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The carboxylate shuttles a proton off the new OH₂⁺ group."
    },
    {
      "stepKey": "nitrogen-protonation",
      "stepKind": "polar",
      "toStateId": "protonated-amine",
      "fromStateId": "carbinolamine",
      "canonicalArrows": [
        "lp N30 -> σ N30-H35",
        "σ O34-H35 -> lp O34"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The same proton moves on to nitrogen, turning proline into a leaving group."
    },
    {
      "stepKey": "proline-release",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "protonated-amine",
      "canonicalArrows": [
        "lp O34 -> σ O34-H39",
        "σ O13-H39 -> π C12-O13",
        "σ C12-N30 -> lp N30"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The C=O re-forms and proline leaves, neutral and with its acid group restored: the catalyst turns over."
    }
  ],
