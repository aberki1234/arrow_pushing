{
  "steps": [
    {
      "stepKey": "phosphorus-attacks-bromine",
      "stepKind": "polar",
      "toStateId": "bromophosphonium",
      "fromStateId": "reactants",
      "canonicalArrows": [
        "lp P6 -> σ P6-Br26",
        "σ Br26-C25 -> lp C25"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Unusually, the nucleophile attacks a halogen, not a carbon. The CBr₃⁻ anion can leave because its three bromines stabilise the negative charge."
    },
    {
      "stepKey": "deprotonation",
      "stepKind": "polar",
      "toStateId": "alkoxide",
      "fromStateId": "bromophosphonium",
      "canonicalArrows": [
        "lp C25 -> σ C25-H5",
        "σ O4-H5 -> lp O4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "Bromoform, CHBr₃, forms. The alkoxide is a much better nucleophile than the neutral alcohol."
    },
    {
      "stepKey": "alcohol-attacks-phosphorus",
      "stepKind": "polar",
      "toStateId": "protonated-alkoxyphosphonium",
      "fromStateId": "bromophosphonium",
      "canonicalArrows": [
        "lp O4 -> σ O4-P6",
        "σ P6-Br26 -> lp Br26"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "Also correct: the neutral alcohol can attack phosphorus first and lose its proton afterwards. Both orders reach the same alkoxyphosphonium ion."
    },
    {
      "stepKey": "late-deprotonation",
      "stepKind": "polar",
      "toStateId": "alkoxyphosphonium",
      "fromStateId": "protonated-alkoxyphosphonium",
      "canonicalArrows": [
        "lp C25 -> σ C25-H5",
        "σ O4-H5 -> lp O4"
      ],
      "routePreference": "accepted",
      "explanationAfterStep": "The same alkoxyphosphonium ion as the other order."
    },
    {
      "stepKey": "alkoxide-attacks-phosphorus",
      "stepKind": "polar",
      "toStateId": "alkoxyphosphonium",
      "fromStateId": "alkoxide",
      "canonicalArrows": [
        "lp O4 -> σ O4-P6",
        "σ P6-Br26 -> lp Br26"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "The oxygen is now bonded to phosphorus: it will leave as triphenylphosphine oxide, an excellent leaving group because the P=O bond that forms is very strong."
    },
    {
      "stepKey": "substitution",
      "stepKind": "polar",
      "toStateId": "products",
      "fromStateId": "alkoxyphosphonium",
      "canonicalArrows": [
        "lp Br26 -> σ Br26-C3",
        "σ C3-O4 -> lp O4"
      ],
      "routePreference": "preferred",
      "explanationAfterStep": "SN2: a stereocentre here would be inverted. Triphenylphosphine oxide is drawn as Ph₃P⁺–O⁻; Ph₃P=O is the same molecule."
    }
  ],
