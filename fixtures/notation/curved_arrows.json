{
  "description": "Shared cases for the curved-arrow notation parser and printer (Python and TypeScript). validCases: the notation, the structure it must parse to, and its printed (canonical) form: σ/π symbols, bond atoms in ascending map-number order. invalidCases: notation that must be refused with the given error code. Notation: docs/schema-design.md section 2.",
  "validCases": [
    {"notation": "lp O1 -> σ O1-C2", "printed": "lp O1 -> σ O1-C2",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "lonePair", "atoms": [{"element": "O", "mapNumber": 1}]},
                     "destination": {"locusKind": "sigmaBond", "atoms": [{"element": "O", "mapNumber": 1}, {"element": "C", "mapNumber": 2}]}}},
    {"notation": "σ C2-Br3 -> lp Br3", "printed": "σ C2-Br3 -> lp Br3",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "sigmaBond", "atoms": [{"element": "C", "mapNumber": 2}, {"element": "Br", "mapNumber": 3}]},
                     "destination": {"locusKind": "lonePair", "atoms": [{"element": "Br", "mapNumber": 3}]}}},
    {"notation": "σ Br3-C2 -> lp Br3", "printed": "σ C2-Br3 -> lp Br3",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "sigmaBond", "atoms": [{"element": "C", "mapNumber": 2}, {"element": "Br", "mapNumber": 3}]},
                     "destination": {"locusKind": "lonePair", "atoms": [{"element": "Br", "mapNumber": 3}]}}},
    {"notation": "sigma C2-Br3 -> lp Br3", "printed": "σ C2-Br3 -> lp Br3",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "sigmaBond", "atoms": [{"element": "C", "mapNumber": 2}, {"element": "Br", "mapNumber": 3}]},
                     "destination": {"locusKind": "lonePair", "atoms": [{"element": "Br", "mapNumber": 3}]}}},
    {"notation": "pi C5-O6 -> lp O6", "printed": "π C5-O6 -> lp O6",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "piBond", "atoms": [{"element": "C", "mapNumber": 5}, {"element": "O", "mapNumber": 6}]},
                     "destination": {"locusKind": "lonePair", "atoms": [{"element": "O", "mapNumber": 6}]}}},
    {"notation": "π C3-C5 -> σ C3-C9", "printed": "π C3-C5 -> σ C3-C9",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "piBond", "atoms": [{"element": "C", "mapNumber": 3}, {"element": "C", "mapNumber": 5}]},
                     "destination": {"locusKind": "sigmaBond", "atoms": [{"element": "C", "mapNumber": 3}, {"element": "C", "mapNumber": 9}]}}},
    {"notation": "σ P1-C2 -> π C2-C3", "printed": "σ P1-C2 -> π C2-C3",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "sigmaBond", "atoms": [{"element": "P", "mapNumber": 1}, {"element": "C", "mapNumber": 2}]},
                     "destination": {"locusKind": "piBond", "atoms": [{"element": "C", "mapNumber": 2}, {"element": "C", "mapNumber": 3}]}}},
    {"notation": "lp Cl12 -> σ C3-Cl12", "printed": "lp Cl12 -> σ C3-Cl12",
     "curvedArrow": {"electronsMoved": 2,
                     "source": {"locusKind": "lonePair", "atoms": [{"element": "Cl", "mapNumber": 12}]},
                     "destination": {"locusKind": "sigmaBond", "atoms": [{"element": "C", "mapNumber": 3}, {"element": "Cl", "mapNumber": 12}]}}},
    {"notation": "rad Br1 ~> σ Br1-H2", "printed": "rad Br1 ~> σ Br1-H2",
     "curvedArrow": {"electronsMoved": 1,
                     "source": {"locusKind": "unpairedElectron", "atoms": [{"element": "Br", "mapNumber": 1}]},
                     "destination": {"locusKind": "sigmaBond", "atoms": [{"element": "Br", "mapNumber": 1}, {"element": "H", "mapNumber": 2}]}}},
    {"notation": "σ C3-H2 ~> σ Br1-H2", "printed": "σ H2-C3 ~> σ Br1-H2",
     "curvedArrow": {"electronsMoved": 1,
                     "source": {"locusKind": "sigmaBond", "atoms": [{"element": "H", "mapNumber": 2}, {"element": "C", "mapNumber": 3}]},
                     "destination": {"locusKind": "sigmaBond", "atoms": [{"element": "Br", "mapNumber": 1}, {"element": "H", "mapNumber": 2}]}}},
    {"notation": "σ C3-H2 ~> rad C3", "printed": "σ H2-C3 ~> rad C3",
     "curvedArrow": {"electronsMoved": 1,
                     "source": {"locusKind": "sigmaBond", "atoms": [{"element": "H", "mapNumber": 2}, {"element": "C", "mapNumber": 3}]},
                     "destination": {"locusKind": "unpairedElectron", "atoms": [{"element": "C", "mapNumber": 3}]}}},
    {"notation": "lp O1 ~> σ O1-C2", "printed": "lp O1 ~> σ O1-C2",
     "curvedArrow": {"electronsMoved": 1,
                     "source": {"locusKind": "lonePair", "atoms": [{"element": "O", "mapNumber": 1}]},
                     "destination": {"locusKind": "sigmaBond", "atoms": [{"element": "O", "mapNumber": 1}, {"element": "C", "mapNumber": 2}]}}}
  ],
