    {"notation": "lp o1 -> σ O1-C2", "expectedErrorCode": "malformed-atom-label"},
    {"notation": "lp O01 -> σ O1-C2", "expectedErrorCode": "malformed-atom-label"},
    {"notation": "lp O0 -> σ O1-C2", "expectedErrorCode": "malformed-atom-label"},
    {"notation": "lp O -> σ O1-C2", "expectedErrorCode": "malformed-atom-label"},
    {"notation": "σ C1-C1 -> lp C1", "expectedErrorCode": "bond-to-same-atom"},
    {"notation": "lp O1 -> σ C1-C2", "expectedErrorCode": "conflicting-atom-labels"},
    {"notation": "σ O1-C1 -> lp O1", "expectedErrorCode": "conflicting-atom-labels"},
    {"notation": "lp O1 -> lp O1", "expectedErrorCode": "arrow-to-itself"},
    {"notation": "σ C2-O1 -> σ O1-C2", "expectedErrorCode": "arrow-to-itself"},
    {"notation": "rad Br1 -> σ Br1-H2", "expectedErrorCode": "unpaired-electron-in-pair-arrow"},
    {"notation": "lp O1 -> rad O1", "expectedErrorCode": "unpaired-electron-in-pair-arrow"}
