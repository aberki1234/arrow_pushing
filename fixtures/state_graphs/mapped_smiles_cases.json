{
  "description": "Shared cases for reading a state's mapped SMILES into a state graph (src/stateGraphs/mappedSmilesReading.ts; src/chemistryToolkit/strictReaderAgreement.test.ts checks the valid cases against RDKit too). validCases: the SMILES and the graph it must give. An atom's nonbondingElectronCount is worked out as valence electrons - formal charge - bond orders - hydrogen count; lone pairs and unpaired electrons follow from it (even: all lone pairs; odd: one unpaired electron). invalidCases: SMILES that must be refused with the given error code; each has exactly one problem, so the order in which a reader looks for problems does not matter.",
  "validCases": [
    {"caseName": "hydroxide", "mappedSmiles": "[OH-:1]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "O", "hydrogenCount": 1, "nonbondingElectronCount": 6}], "bonds": []}},
    {"caseName": "bromomethane", "mappedSmiles": "[CH3:2][Br:3]",
     "stateGraph": {"atoms": [{"mapNumber": 2, "element": "C", "hydrogenCount": 3, "nonbondingElectronCount": 0},
                              {"mapNumber": 3, "element": "Br", "hydrogenCount": 0, "nonbondingElectronCount": 6}],
                    "bonds": [{"mapNumbers": [2, 3], "bondOrder": 1}]}},
    {"caseName": "enolate with a double bond", "mappedSmiles": "[CH2:3]=[CH:5][O-:6]",
     "stateGraph": {"atoms": [{"mapNumber": 3, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0},
                              {"mapNumber": 5, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0},
                              {"mapNumber": 6, "element": "O", "hydrogenCount": 0, "nonbondingElectronCount": 6}],
                    "bonds": [{"mapNumbers": [3, 5], "bondOrder": 2}, {"mapNumbers": [5, 6], "bondOrder": 1}]}},
    {"caseName": "bromine radical", "mappedSmiles": "[Br:1]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "Br", "hydrogenCount": 0, "nonbondingElectronCount": 7}], "bonds": []}},
    {"caseName": "methyl radical", "mappedSmiles": "[CH3:3]",
     "stateGraph": {"atoms": [{"mapNumber": 3, "element": "C", "hydrogenCount": 3, "nonbondingElectronCount": 1}], "bonds": []}},
    {"caseName": "explicit mapped hydrogen", "mappedSmiles": "[H:2][CH3:3]",
     "stateGraph": {"atoms": [{"mapNumber": 2, "element": "H", "hydrogenCount": 0, "nonbondingElectronCount": 0},
                              {"mapNumber": 3, "element": "C", "hydrogenCount": 3, "nonbondingElectronCount": 0}],
                    "bonds": [{"mapNumbers": [2, 3], "bondOrder": 1}]}},
    {"caseName": "proton", "mappedSmiles": "[H+:1]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "H", "hydrogenCount": 0, "nonbondingElectronCount": 0}], "bonds": []}},
    {"caseName": "ammonium", "mappedSmiles": "[NH4+:1]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "N", "hydrogenCount": 4, "nonbondingElectronCount": 0}], "bonds": []}},
    {"caseName": "carbon monoxide, triple bond and two charges", "mappedSmiles": "[C-:1]#[O+:2]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "C", "hydrogenCount": 0, "nonbondingElectronCount": 2},
                              {"mapNumber": 2, "element": "O", "hydrogenCount": 0, "nonbondingElectronCount": 2}],
                    "bonds": [{"mapNumbers": [1, 2], "bondOrder": 3}]}},
    {"caseName": "phosphonium ylide with branches", "mappedSmiles": "[CH2-:2][P+:1]([CH3:11])([CH3:12])[CH3:13]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "P", "hydrogenCount": 0, "nonbondingElectronCount": 0},
                              {"mapNumber": 2, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 2},
                              {"mapNumber": 11, "element": "C", "hydrogenCount": 3, "nonbondingElectronCount": 0},
                              {"mapNumber": 12, "element": "C", "hydrogenCount": 3, "nonbondingElectronCount": 0},
                              {"mapNumber": 13, "element": "C", "hydrogenCount": 3, "nonbondingElectronCount": 0}],
                    "bonds": [{"mapNumbers": [1, 2], "bondOrder": 1}, {"mapNumbers": [1, 11], "bondOrder": 1},
                              {"mapNumbers": [1, 12], "bondOrder": 1}, {"mapNumbers": [1, 13], "bondOrder": 1}]}},
    {"caseName": "cyclohexanone, ring closure", "mappedSmiles": "[O:4]=[C:3]1[CH2:5][CH2:6][CH2:7][CH2:8][CH2:9]1",
     "stateGraph": {"atoms": [{"mapNumber": 3, "element": "C", "hydrogenCount": 0, "nonbondingElectronCount": 0},
                              {"mapNumber": 4, "element": "O", "hydrogenCount": 0, "nonbondingElectronCount": 4},
                              {"mapNumber": 5, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0},
                              {"mapNumber": 6, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0},
                              {"mapNumber": 7, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0},
                              {"mapNumber": 8, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0},
                              {"mapNumber": 9, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0}],
                    "bonds": [{"mapNumbers": [3, 4], "bondOrder": 2}, {"mapNumbers": [3, 5], "bondOrder": 1},
                              {"mapNumbers": [3, 9], "bondOrder": 1}, {"mapNumbers": [5, 6], "bondOrder": 1},
                              {"mapNumbers": [6, 7], "bondOrder": 1}, {"mapNumbers": [7, 8], "bondOrder": 1},
                              {"mapNumbers": [8, 9], "bondOrder": 1}]}},
    {"caseName": "Kekulé benzene, ring closure after a double bond", "mappedSmiles": "[CH:1]1=[CH:2][CH:3]=[CH:4][CH:5]=[CH:6]1",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0},
                              {"mapNumber": 2, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0},
                              {"mapNumber": 3, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0},
                              {"mapNumber": 4, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0},
                              {"mapNumber": 5, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0},
                              {"mapNumber": 6, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0}],
                    "bonds": [{"mapNumbers": [1, 2], "bondOrder": 2}, {"mapNumbers": [1, 6], "bondOrder": 1},
                              {"mapNumbers": [2, 3], "bondOrder": 1}, {"mapNumbers": [3, 4], "bondOrder": 2},
                              {"mapNumbers": [4, 5], "bondOrder": 1}, {"mapNumbers": [5, 6], "bondOrder": 2}]}},
    {"caseName": "ring closure with a bond symbol", "mappedSmiles": "[CH:1]=1[CH2:2][CH2:3][CH:4]=1",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0},
                              {"mapNumber": 2, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0},
                              {"mapNumber": 3, "element": "C", "hydrogenCount": 2, "nonbondingElectronCount": 0},
                              {"mapNumber": 4, "element": "C", "hydrogenCount": 1, "nonbondingElectronCount": 0}],
                    "bonds": [{"mapNumbers": [1, 2], "bondOrder": 1}, {"mapNumbers": [1, 4], "bondOrder": 2},
                              {"mapNumbers": [2, 3], "bondOrder": 1}, {"mapNumbers": [3, 4], "bondOrder": 1}]}},
    {"caseName": "three molecules, with a counterion", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "O", "hydrogenCount": 1, "nonbondingElectronCount": 6},
                              {"mapNumber": 2, "element": "C", "hydrogenCount": 3, "nonbondingElectronCount": 0},
                              {"mapNumber": 3, "element": "Br", "hydrogenCount": 0, "nonbondingElectronCount": 6},
                              {"mapNumber": 4, "element": "Na", "hydrogenCount": 0, "nonbondingElectronCount": 0}],
                    "bonds": [{"mapNumbers": [2, 3], "bondOrder": 1}]}},
    {"caseName": "double charge written as a number", "mappedSmiles": "[O-2:1]",
     "stateGraph": {"atoms": [{"mapNumber": 1, "element": "O", "hydrogenCount": 0, "nonbondingElectronCount": 8}], "bonds": []}}
  ],
  "invalidCases": [
    {"caseName": "empty", "mappedSmiles": "", "expectedErrorCode": "malformed-smiles"},
    {"caseName": "unclosed bracket", "mappedSmiles": "[OH-:1", "expectedErrorCode": "malformed-smiles"},
    {"caseName": "unclosed branch", "mappedSmiles": "[CH3:2]([Br:3]", "expectedErrorCode": "malformed-smiles"},
    {"caseName": "unclosed ring", "mappedSmiles": "[CH2:1]1[CH2:2][CH2:3]", "expectedErrorCode": "malformed-smiles"},
    {"caseName": "bare atom without brackets", "mappedSmiles": "C[CH3:2]", "expectedErrorCode": "unmapped-atom"},
    {"caseName": "bracket atom without map number", "mappedSmiles": "[CH3][Br:3]", "expectedErrorCode": "unmapped-atom"},
    {"caseName": "aromatic atoms", "mappedSmiles": "[cH:1]1[cH:2][cH:3][cH:4][cH:5][cH:6]1", "expectedErrorCode": "aromatic-notation"},
    {"caseName": "aromatic bond", "mappedSmiles": "[CH3:1]:[CH3:2]", "expectedErrorCode": "aromatic-notation"},
    {"caseName": "isotope", "mappedSmiles": "[13CH4:1]", "expectedErrorCode": "unsupported-smiles-feature"},
    {"caseName": "tetrahedral stereo mark", "mappedSmiles": "[C@H:1]([F:2])([Cl:3])[Br:4]", "expectedErrorCode": "unsupported-smiles-feature"},
    {"caseName": "double-bond stereo marks", "mappedSmiles": "[F:1]/[CH:2]=[CH:3]/[F:4]", "expectedErrorCode": "unsupported-smiles-feature"},
    {"caseName": "wildcard atom", "mappedSmiles": "[*:1]", "expectedErrorCode": "unsupported-smiles-feature"},
    {"caseName": "quadruple bond", "mappedSmiles": "[CH3:1]$[CH3:2]", "expectedErrorCode": "unsupported-smiles-feature"},
    {"caseName": "same map number twice", "mappedSmiles": "[CH3:1][CH3:1]", "expectedErrorCode": "duplicate-map-number"},
    {"caseName": "element without a valence entry", "mappedSmiles": "[Xe:1]", "expectedErrorCode": "unsupported-element"},
    {"caseName": "more bonds and hydrogens than valence electrons", "mappedSmiles": "[CH5:1]", "expectedErrorCode": "impossible-electron-count"}
  ]
}
