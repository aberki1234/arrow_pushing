{
  "description": "Shared cases for applying the curved arrows of one step to a state (src/core/stateGraphs/arrowApplication.ts). All arrows of a step are applied together. validCases: the state, the arrows, and the mapped SMILES of the state they must give. invalidCases: arrows that must be refused with the given generic rule id. Rule ids and the order they are checked in: docs/schema-design.md section 4.",
  "validCases": [
    {"caseName": "SN2: lone pair forms a bond while a bond breaks",
     "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["lp O1 -> σ O1-C2", "σ C2-Br3 -> lp Br3"],
     "expectedMappedSmiles": "[OH:1][CH3:2].[Br-:3].[Na+:4]"},
    {"caseName": "SN2 with the arrows in the other order",
     "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["σ C2-Br3 -> lp Br3", "lp O1 -> σ O1-C2"],
     "expectedMappedSmiles": "[OH:1][CH3:2].[Br-:3].[Na+:4]"},
    {"caseName": "enolate formation: a relay through the pi system",
     "mappedSmiles": "[H:2][O-:1].[H:4][CH2:3][CH:5]=[O:6]",
     "curvedArrows": ["lp O1 -> σ O1-H4", "σ C3-H4 -> π C3-C5", "π C5-O6 -> lp O6"],
     "expectedMappedSmiles": "[H:2][O:1][H:4].[CH2:3]=[CH:5][O-:6]"},
    {"caseName": "protonation of water by a proton",
     "mappedSmiles": "[OH2:1].[H+:2]",
     "curvedArrows": ["lp O1 -> σ O1-H2"],
     "expectedMappedSmiles": "[OH2+:1][H:2]"},
    {"caseName": "pi bond breaks onto oxygen",
     "mappedSmiles": "[CH2:1]=[O:2]",
     "curvedArrows": ["π C1-O2 -> lp O2"],
     "expectedMappedSmiles": "[CH2+:1][O-:2]"},
    {"caseName": "hydrogen abstraction with three fish-hooks",
     "mappedSmiles": "[Br:1].[H:2][CH3:3].[Br:4][Br:5]",
     "curvedArrows": ["rad Br1 ~> σ Br1-H2", "σ C3-H2 ~> σ Br1-H2", "σ C3-H2 ~> rad C3"],
     "expectedMappedSmiles": "[Br:1][H:2].[CH3:3].[Br:4][Br:5]"},
    {"caseName": "homolysis of Br2",
     "mappedSmiles": "[Br:1][Br:2]",
     "curvedArrows": ["σ Br1-Br2 ~> rad Br1", "σ Br1-Br2 ~> rad Br2"],
     "expectedMappedSmiles": "[Br:1].[Br:2]"},
    {"caseName": "radical recombination",
     "mappedSmiles": "[CH3:1].[CH3:2]",
     "curvedArrows": ["rad C1 ~> σ C1-C2", "rad C2 ~> σ C1-C2"],
     "expectedMappedSmiles": "[CH3:1][CH3:2]"},
    {"caseName": "stereo: a stereocentre the arrows do not touch keeps its mark",
     "mappedSmiles": "[CH3:1][C@@H:2]([O:3][H:7])[CH2:4][CH3:5].[OH-:6]",
     "curvedArrows": ["lp O6 -> σ O6-H7", "σ O3-H7 -> lp O3"],
     "expectedMappedSmiles": "[CH3:1][C@@H:2]([O-:3])[CH2:4][CH3:5].[OH:6][H:7]"},
    {"caseName": "stereo: SN2 drops the attacked centre's mark (the to-state decides inversion)",
     "mappedSmiles": "[OH-:1].[CH3:2][C@@H:3]([Br:4])[CH2:5][CH3:6]",
     "curvedArrows": ["lp O1 -> σ O1-C3", "σ C3-Br4 -> lp Br4"],
     "expectedMappedSmiles": "[OH:1][CH:3]([CH3:2])[CH2:5][CH3:6].[Br-:4]"},
    {"caseName": "stereo: opening a bromonium ion keeps the mark of the carbon not attacked",
     "mappedSmiles": "[Br+:7]1[C@H:1]2[C@@H:2]1[CH2:3][CH2:4][CH2:5][CH2:6]2.[Br-:8]",
     "curvedArrows": ["lp Br8 -> σ Br8-C1", "σ C1-Br7 -> lp Br7"],
     "expectedMappedSmiles": "[Br:7][C@@H:2]1[CH:1]([Br:8])[CH2:6][CH2:5][CH2:4][CH2:3]1"},
    {"caseName": "stereo: an untouched double bond keeps cis or trans",
     "mappedSmiles": "[CH3:1]/[CH:2]=[CH:3]/[CH2:4][O:5][H:6].[OH-:7]",
     "curvedArrows": ["lp O7 -> σ O7-H6", "σ O5-H6 -> lp O5"],
     "expectedMappedSmiles": "[CH3:1]/[CH:2]=[CH:3]/[CH2:4][O-:5].[OH:7][H:6]"},
    {"caseName": "stereo: E2 drops the marks of the centres that become the double bond",
     "mappedSmiles": "[CH3:1][C@@H:2]([Br:3])[CH:4]([H:6])[CH3:5].[OH-:7]",
     "curvedArrows": ["lp O7 -> σ O7-H6", "σ C4-H6 -> π C2-C4", "σ C2-Br3 -> lp Br3"],
     "expectedMappedSmiles": "[CH3:1][CH:2]=[CH:4][CH3:5].[Br-:3].[OH:7][H:6]"}
  ],
  "invalidCases": [
    {"caseName": "map number not in the state", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["lp O9 -> σ O9-C2"], "expectedRuleId": "atom-not-in-state"},
    {"caseName": "element does not match the atom", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["lp N1 -> σ N1-C2"], "expectedRuleId": "atom-not-in-state"},
    {"caseName": "destination shares no atom with the source", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["lp O1 -> σ C2-Br3"], "expectedRuleId": "destination-not-adjacent-to-source"},
    {"caseName": "lone pair on an atom that has none", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["lp C2 -> σ O1-C2"], "expectedRuleId": "no-electrons-at-source"},
    {"caseName": "source bond that does not exist", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["σ O1-C2 -> lp O1"], "expectedRuleId": "no-electrons-at-source"},
    {"caseName": "pi source on a single bond", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["π C2-Br3 -> lp Br3"], "expectedRuleId": "no-electrons-at-source"},
    {"caseName": "unpaired electron on an atom that has none", "mappedSmiles": "[OH-:1].[CH3:2][Br:3]",
     "curvedArrows": ["rad O1 ~> σ O1-C2"], "expectedRuleId": "no-electrons-at-source"},
    {"caseName": "one lone pair used twice", "mappedSmiles": "[NH3:1].[H+:2].[H+:3]",
     "curvedArrows": ["lp N1 -> σ N1-H2", "lp N1 -> σ N1-H3"], "expectedRuleId": "no-electrons-at-source"},
    {"caseName": "new sigma bond where a bond already exists", "mappedSmiles": "[OH:1][CH3:2]",
     "curvedArrows": ["lp O1 -> σ O1-C2"], "expectedRuleId": "destination-bond-already-exists"},
    {"caseName": "pi destination where there is no bond", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["lp O1 -> π O1-C2"], "expectedRuleId": "destination-bond-missing"},
    {"caseName": "fish-hook into a lone pair", "mappedSmiles": "[Br:1][Br:2]",
     "curvedArrows": ["σ Br1-Br2 ~> lp Br1"], "expectedRuleId": "fish-hook-to-lone-pair"},
    {"caseName": "only one electron put into a new bond", "mappedSmiles": "[Br:1].[H:2][CH3:3].[Br:4][Br:5]",
     "curvedArrows": ["rad Br1 ~> σ Br1-H2"], "expectedRuleId": "odd-electrons-in-bond"},
    {"caseName": "bond order would be four", "mappedSmiles": "[C-:1]#[O+:2]",
     "curvedArrows": ["lp C1 -> π C1-O2"], "expectedRuleId": "bond-order-above-three"},
    {"caseName": "carbon would have ten electrons", "mappedSmiles": "[OH-:1].[CH3:2][Br:3].[Na+:4]",
     "curvedArrows": ["lp O1 -> σ O1-C2"], "expectedRuleId": "octet-exceeded"},
    {"caseName": "hydrogen would have two bonds", "mappedSmiles": "[H:2][O-:1].[H:4][CH2:3][CH:5]=[O:6]",
     "curvedArrows": ["lp O1 -> σ O1-H4"], "expectedRuleId": "octet-exceeded"}
  ]
}
