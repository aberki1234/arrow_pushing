{
  "description": "Edits that make a clean example reaction break lint rules (src/tooling/reactionLinting). Each case names the example (baseReactionFile in fixtures/reactions) and a list of edits applied in order. An edit sets newValue at pathToSet, copies the value found at copyFromPath to pathToSet, or deletes the key or list position at pathToDelete; a list position one past the end appends. expectedLintRuleIds is the sorted list of distinct rule ids the linter must report, and nothing else.",
  "cases": [
    {"caseName": "schema violation stops the lint", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToDelete": ["startStateId"]}],
     "expectedLintRuleIds": ["schema-violation"]},
    {"caseName": "map number changes element between states", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["stateIdToState", "products", "mappedSmiles"], "newValue": "[OH:1][CH3:2].[Br-:3].[K+:4]"}],
     "expectedLintRuleIds": ["state-atoms-inconsistent"]},
    {"caseName": "stereo bond outside the strict SMILES subset", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["stateIdToState", "products", "mappedSmiles"], "newValue": "[OH:1]/[CH3:2].[Br-:3].[Na+:4]"}],
     "expectedLintRuleIds": ["mapped-smiles-not-supported"]},
    {"caseName": "step to an unknown state", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["steps", 0, "toStateId"], "newValue": "nowhere"}],
     "expectedLintRuleIds": ["step-state-id-unknown"]},
    {"caseName": "two steps share a step key", "baseReactionFile": "radical-bromination-methane.json",
     "edits": [{"pathToSet": ["steps", 1, "stepKey"], "newValue": "hydrogen-abstraction"}],
     "expectedLintRuleIds": ["duplicate-step-key"]},
    {"caseName": "branch state no longer reachable", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToDelete": ["steps", 1]}],
     "expectedLintRuleIds": ["state-unreachable"]},
    {"caseName": "reversible ring opening makes a cycle", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToSet": ["steps", 4], "newValue": {
       "stepKey": "ring-opening", "fromStateId": "oxaphosphetane", "toStateId": "betaine", "stepKind": "polar",
       "routePreference": "accepted", "canonicalArrows": ["σ O4-P1 -> lp O4"]}}],
     "expectedLintRuleIds": ["mechanism-has-cycle"]},
    {"caseName": "last step removed leaves the old product unreachable", "baseReactionFile": "aldol-addition-base.json",
     "edits": [{"pathToDelete": ["steps", 3]}],
     "expectedLintRuleIds": ["state-unreachable"]},
    {"caseName": "an accepted route ending in its own state is an alternative product", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToDelete": ["steps", 2]}],
     "expectedLintRuleIds": []},
    {"caseName": "an alternative product without a caption", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToDelete": ["steps", 2]}, {"pathToDelete": ["stateIdToState", "betaine", "caption"]}],
     "expectedLintRuleIds": ["alternative-product-without-caption"]},
    {"caseName": "both Wittig routes preferred", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToSet": ["steps", 1, "routePreference"], "newValue": "preferred"}],
     "expectedLintRuleIds": ["several-preferred-steps-leave-state"]},
    {"caseName": "no preferred step out of the start state", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToSet": ["steps", 0, "routePreference"], "newValue": "accepted"}],
     "expectedLintRuleIds": ["preferred-route-does-not-reach-product"]},
    {"caseName": "change step shares its state with another step", "baseReactionFile": "aldol-addition-base.json",
     "edits": [{"pathToSet": ["steps", 4], "newValue": {
       "stepKey": "aldehyde-leaves-again", "fromStateId": "enolate", "toStateId": "aldol-product", "stepKind": "change",
       "routePreference": "accepted", "removedFragmentMapNumbers": [1]}}],
     "expectedLintRuleIds": ["change-step-not-alone", "step-does-not-reproduce-to-state"]},
    {"caseName": "two leaving steps reach the same state drawn twice", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToSet": ["stateIdToState", "oxaphosphetane-again"], "copyFromPath": ["stateIdToState", "oxaphosphetane"]},
               {"pathToSet": ["steps", 4], "copyFromPath": ["steps", 0]},
               {"pathToSet": ["steps", 4, "stepKey"], "newValue": "cycloaddition-again"},
               {"pathToSet": ["steps", 4, "toStateId"], "newValue": "oxaphosphetane-again"},
               {"pathToSet": ["steps", 4, "routePreference"], "newValue": "accepted"},
               {"pathToSet": ["steps", 5], "copyFromPath": ["steps", 3]},
               {"pathToSet": ["steps", 5, "stepKey"], "newValue": "retro-cycloaddition-again"},
               {"pathToSet": ["steps", 5, "fromStateId"], "newValue": "oxaphosphetane-again"}],
     "expectedLintRuleIds": ["leaving-steps-reach-equivalent-states"]},
    {"caseName": "canonical arrows break the octet", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["steps", 0, "canonicalArrows"], "newValue": ["lp O1 -> σ O1-C2"]}],
     "expectedLintRuleIds": ["step-does-not-reproduce-to-state"]},
    {"caseName": "canonical arrows give a resonance form, not the drawing", "baseReactionFile": "aldol-addition-base.json",
     "edits": [{"pathToSet": ["steps", 0, "canonicalArrows"], "newValue": ["lp O1 -> σ O1-H4", "σ C3-H4 -> lp C3"]}],
     "expectedLintRuleIds": ["step-does-not-reproduce-to-state"]},
    {"caseName": "partial arrow set is not a complete step", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["steps", 0, "partialArrowSets"], "newValue": [["lp O1 -> σ O1-C2"]]}],
     "expectedLintRuleIds": ["step-does-not-reproduce-to-state"]},
    {"caseName": "partial arrow set giving a resonance form is accepted", "baseReactionFile": "aldol-addition-base.json",
     "edits": [{"pathToSet": ["steps", 0, "partialArrowSets"], "newValue": [["lp O1 -> σ O1-H4", "σ C3-H4 -> lp C3"]]}],
     "expectedLintRuleIds": []},
    {"caseName": "change step adds the wrong molecule", "baseReactionFile": "aldol-addition-base.json",
     "edits": [{"pathToSet": ["steps", 1, "addedSpecies"], "newValue": "[CH3:8][CH2:9][OH:10]"}],
     "expectedLintRuleIds": ["step-does-not-reproduce-to-state"]},
    {"caseName": "misconception names an unknown role", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["stateIdToState", "reactants", "misconceptions", 0, "arrowPattern"], "newValue": "lp @nobody -> Br3"}],
     "expectedLintRuleIds": ["misconception-pattern-invalid"]},
    {"caseName": "two misconceptions share an id", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["stateIdToState", "reactants", "misconceptions", 1, "misconceptionId"], "newValue": "attack-on-bromine"}],
     "expectedLintRuleIds": ["duplicate-misconception-id"]},
    {"caseName": "misconception matches the canonical arrows", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["stateIdToState", "reactants", "misconceptions", 0, "arrowPattern"], "newValue": "lp O1 -> C2"}],
     "expectedLintRuleIds": ["misconception-hides-correct-answer"]},
    {"caseName": "misconception matches the canonical arrows only up to symmetry", "baseReactionFile": "aldol-addition-base.json",
     "edits": [{"pathToSet": ["stateIdToState", "reactants", "misconceptions", 0, "arrowPattern"], "newValue": "σ C3-H7 -> π C3-C5"},
               {"pathToSet": ["stateIdToState", "reactants", "mappedSmiles"], "newValue": "[H:2][O-:1].[H:4][C:3]([H:7])([H:11])[CH:5]=[O:6]"},
               {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "7"], "newValue": [0.0, 1.0]},
               {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "11"], "newValue": [0.0, -1.0]},
               {"pathToSet": ["stateIdToState", "enolate", "mappedSmiles"], "newValue": "[H:2][O:1][H:4].[H:7][C:3]([H:11])=[CH:5][O-:6]"},
               {"pathToSet": ["stateIdToState", "enolate", "mapNumberToCoordinates", "7"], "newValue": [0.0, 1.0]},
               {"pathToSet": ["stateIdToState", "enolate", "mapNumberToCoordinates", "11"], "newValue": [0.0, -1.0]},
               {"pathToSet": ["stateIdToState", "enolate-and-aldehyde", "mappedSmiles"], "newValue": "[H:2][O:1][H:4].[H:7][C:3]([H:11])=[CH:5][O-:6].[CH3:8][CH:9]=[O:10]"},
               {"pathToSet": ["stateIdToState", "enolate-and-aldehyde", "mapNumberToCoordinates", "7"], "newValue": [0.0, 1.0]},
               {"pathToSet": ["stateIdToState", "enolate-and-aldehyde", "mapNumberToCoordinates", "11"], "newValue": [0.0, -1.0]},
               {"pathToSet": ["stateIdToState", "alkoxide", "mappedSmiles"], "newValue": "[H:2][O:1][H:4].[O:6]=[CH:5][C:3]([H:7])([H:11])[CH:9]([CH3:8])[O-:10]"},
               {"pathToSet": ["stateIdToState", "alkoxide", "mapNumberToCoordinates", "7"], "newValue": [0.0, 1.0]},
               {"pathToSet": ["stateIdToState", "alkoxide", "mapNumberToCoordinates", "11"], "newValue": [0.0, -1.0]},
               {"pathToSet": ["stateIdToState", "aldol-product", "mappedSmiles"], "newValue": "[H:2][O-:1].[O:6]=[CH:5][C:3]([H:7])([H:11])[CH:9]([CH3:8])[O:10][H:4]"},
               {"pathToSet": ["stateIdToState", "aldol-product", "mapNumberToCoordinates", "7"], "newValue": [0.0, 1.0]},
               {"pathToSet": ["stateIdToState", "aldol-product", "mapNumberToCoordinates", "11"], "newValue": [0.0, -1.0]}],
     "expectedLintRuleIds": ["misconception-hides-correct-answer"]},
    {"caseName": "misconception covered by an earlier wider one", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["stateIdToState", "reactants", "misconceptions", 1, "arrowPattern"], "newValue": "lp O1 -> Br3; lp Br3 -> C2"}],
     "expectedLintRuleIds": ["misconception-never-fires"]},
    {"caseName": "no learner prompt where arrows are drawn", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToDelete": ["stateIdToState", "reactants", "learnerPrompt"]}],
     "expectedLintRuleIds": ["learner-prompt-missing"]},
    {"caseName": "no hint tiers where arrows are drawn", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToDelete": ["stateIdToState", "reactants", "hintTiers"]}],
     "expectedLintRuleIds": ["hint-tiers-missing"]},
    {"caseName": "one hint tier only", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "edits": [{"pathToSet": ["stateIdToState", "reactants", "hintTiers"], "newValue": ["Which atom has a lone pair to give?"]}],
     "expectedLintRuleIds": ["fewer-than-three-hint-tiers"]},
    {"caseName": "no learner text needed after a change step's state", "baseReactionFile": "aldol-addition-base.json",
     "edits": [],
     "expectedLintRuleIds": []},
    {"caseName": "abbreviated group names an unknown atom", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToSet": ["abbreviatedGroups", 0, "mapNumbers"], "newValue": [11, 12, 13, 14, 15, 16, 99]}],
     "expectedLintRuleIds": ["abbreviated-group-atoms-unknown"]},
    {"caseName": "abbreviated ring missing one atom is attached by three bonds", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToSet": ["abbreviatedGroups", 0, "mapNumbers"], "newValue": [11, 12, 13, 14, 15]}],
     "expectedLintRuleIds": ["abbreviated-group-not-attached-once"]},
    {"caseName": "abbreviated group attached from an atom outside it", "baseReactionFile": "wittig-methylenation-cyclohexanone.json",
     "edits": [{"pathToSet": ["abbreviatedGroups", 0, "attachmentMapNumber"], "newValue": 2}],
     "expectedLintRuleIds": ["abbreviated-group-not-attached-once"]},
    {"caseName": "canonical arrows use an abbreviated atom", "baseReactionFile": "radical-bromination-methane.json",
     "edits": [{"pathToSet": ["abbreviatedGroups"], "newValue": [{"groupLabel": "H", "attachmentMapNumber": 2, "mapNumbers": [2]}]},
               {"pathToDelete": ["stateIdToState", "methyl-radical", "misconceptions", 0]}],
     "expectedLintRuleIds": ["arrow-touches-abbreviated-group"]},
    {"caseName": "misconception names an abbreviated atom", "baseReactionFile": "aldol-addition-base.json",
     "edits": [{"pathToSet": ["abbreviatedGroups"], "newValue": [{"groupLabel": "Me", "attachmentMapNumber": 8, "mapNumbers": [8]}]}],
     "expectedLintRuleIds": ["misconception-in-abbreviated-group"]},
    {"caseName": "stereo: the wedges show the other configuration from the SMILES mark", "baseReactionFile": "sn2-2-bromobutane-inversion.json", "edits": [{"pathToSet": ["stateIdToState", "products", "bondToWedgeStyle"], "newValue": {"2-5": "dash"}}], "expectedLintRuleIds": ["wedges-disagree-with-smiles"]},
    {"caseName": "stereo: a stereo mark with no wedge or dash", "baseReactionFile": "sn2-2-bromobutane-inversion.json", "edits": [{"pathToDelete": ["stateIdToState", "products", "bondToWedgeStyle"]}], "expectedLintRuleIds": ["wedges-disagree-with-smiles"]},
    {"caseName": "stereo: a wedge at an atom with no stereo mark", "baseReactionFile": "sn2-2-bromobutane-inversion.json", "edits": [{"pathToSet": ["stateIdToState", "reactants", "bondToWedgeStyle", "6-7"], "newValue": "wedge"}], "expectedLintRuleIds": ["wedges-disagree-with-smiles"]},
    {"caseName": "stereo: a centre no arrow touches changes configuration", "baseReactionFile": "sn2-2-bromobutane-inversion.json", "edits": [{"pathToDelete": ["steps", 0, "stereoQuestion"]}, {"pathToSet": ["stateIdToState", "reactants", "mappedSmiles"], "newValue": "[OH-:1].[CH3:5][C@@H:2]([Br:3])[C@@H:6]([Cl:8])[CH3:7].[Na+:4]"}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates"], "newValue": {"1": [-3.3, 0], "2": [0, 0], "3": [1.5, 0], "4": [-3.3, -1.9], "5": [-0.75, 1.3], "6": [-0.75, -1.3], "7": [0, -2.6], "8": [-2.25, -1.3]}}, {"pathToSet": ["stateIdToState", "reactants", "bondToWedgeStyle"], "newValue": {"2-5": "wedge", "6-7": "dash"}}, {"pathToSet": ["stateIdToState", "products", "mappedSmiles"], "newValue": "[OH:1][C@@H:2]([CH3:5])[C@H:6]([Cl:8])[CH3:7].[Br-:3].[Na+:4]"}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates"], "newValue": {"1": [-1.5, 0], "2": [0, 0], "3": [3.6, 0.8], "4": [-3.3, -1.9], "5": [0.75, 1.3], "6": [0.75, -1.3], "7": [2.25, -1.3], "8": [0, -2.6]}}, {"pathToSet": ["stateIdToState", "products", "bondToWedgeStyle"], "newValue": {"2-5": "wedge", "6-7": "wedge"}}], "expectedLintRuleIds": ["step-does-not-reproduce-to-state", "stereocentre-changes-without-arrows"]},
    {"caseName": "stereo: a stereocentre left unmarked in a state that marks another", "baseReactionFile": "sn2-2-bromobutane-inversion.json", "edits": [{"pathToDelete": ["steps", 0, "stereoQuestion"]}, {"pathToSet": ["stateIdToState", "reactants", "mappedSmiles"], "newValue": "[OH-:1].[CH3:5][C@@H:2]([Br:3])[CH:6]([Cl:8])[CH3:7].[Na+:4]"}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates"], "newValue": {"1": [-3.3, 0], "2": [0, 0], "3": [1.5, 0], "4": [-3.3, -1.9], "5": [-0.75, 1.3], "6": [-0.75, -1.3], "7": [0, -2.6], "8": [-2.25, -1.3]}}, {"pathToSet": ["stateIdToState", "reactants", "bondToWedgeStyle"], "newValue": {"2-5": "wedge"}}, {"pathToSet": ["stateIdToState", "products", "mappedSmiles"], "newValue": "[OH:1][C@@H:2]([CH3:5])[CH:6]([Cl:8])[CH3:7].[Br-:3].[Na+:4]"}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates"], "newValue": {"1": [-1.5, 0], "2": [0, 0], "3": [3.6, 0.8], "4": [-3.3, -1.9], "5": [0.75, 1.3], "6": [0.75, -1.3], "7": [2.25, -1.3], "8": [0, -2.6]}}, {"pathToSet": ["stateIdToState", "products", "bondToWedgeStyle"], "newValue": {"2-5": "wedge"}}], "expectedLintRuleIds": ["stereocentre-unspecified"]},
    {"caseName": "stereo: atoms alike but for their map numbers are not stereocentres", "baseReactionFile": "sn2-2-bromobutane-inversion.json", "edits": [{"pathToDelete": ["steps", 0, "stereoQuestion"]}, {"pathToSet": ["stateIdToState", "reactants", "mappedSmiles"], "newValue": "[OH-:1].[CH3:5][C@@H:2]([Br:3])[CH2:6][CH3:7].[Na+:4].[CH3:8][C:9]([CH3:10])([H:11])[S:12](=[O:13])(=[O:14])[O-:15]"}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "8"], "newValue": [-5, 3]}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "9"], "newValue": [-4, 3.75]}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "10"], "newValue": [-3, 3]}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "11"], "newValue": [-4, 4.9]}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "12"], "newValue": [-2.6, 4.5]}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "13"], "newValue": [-2.6, 5.9]}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "14"], "newValue": [-1.4, 4.0]}, {"pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "15"], "newValue": [-3.0, 5.6]}, {"pathToSet": ["stateIdToState", "products", "mappedSmiles"], "newValue": "[OH:1][C@@H:2]([CH3:5])[CH2:6][CH3:7].[Br-:3].[Na+:4].[CH3:8][C:9]([CH3:10])([H:11])[S:12](=[O:13])(=[O:14])[O-:15]"}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates", "8"], "newValue": [-5, 3]}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates", "9"], "newValue": [-4, 3.75]}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates", "10"], "newValue": [-3, 3]}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates", "11"], "newValue": [-4, 4.9]}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates", "12"], "newValue": [-2.6, 4.5]}, {"pathToSet": ["stateIdToState", "products", "mapNumberToCoordinates", "1