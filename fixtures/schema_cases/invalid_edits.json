{
  "description": "Edits that make a valid example reaction invalid. Each case names the example (baseReactionFile in fixtures/reactions), one edit (set a value at pathToSet, or delete the key at pathToDelete), and the JSON pointer at which a schema violation must be reported. The Python and TypeScript tests both run every case.",
  "cases": [
    {"caseName": "missing start state id", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToDelete": ["startStateId"], "expectedViolationPath": ""},
    {"caseName": "unknown top-level key", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["notes"], "newValue": "free text", "expectedViolationPath": ""},
    {"caseName": "wrong format version", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["formatVersion"], "newValue": 2, "expectedViolationPath": "/formatVersion"},
    {"caseName": "reaction slug not lower-case with hyphens", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["reactionSlug"], "newValue": "SN2_Hydroxide", "expectedViolationPath": "/reactionSlug"},
    {"caseName": "difficulty tier above three", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["difficultyTier"], "newValue": 4, "expectedViolationPath": "/difficultyTier"},
    {"caseName": "reaction class not in the controlled list", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["reactionClasses", 0], "newValue": "magic", "expectedViolationPath": "/reactionClasses/0"},
    {"caseName": "licence other than CC BY-SA 4.0", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["licence"], "newValue": "MIT", "expectedViolationPath": "/licence"},
    {"caseName": "no steps", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["steps"], "newValue": [], "expectedViolationPath": "/steps"},
    {"caseName": "route preference not preferred or accepted", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["steps", 0, "routePreference"], "newValue": "maybe", "expectedViolationPath": "/steps/0/routePreference"},
    {"caseName": "fish-hook arrow in a polar step", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["steps", 0, "canonicalArrows", 0], "newValue": "lp O1 ~> σ O1-C2", "expectedViolationPath": "/steps/0/canonicalArrows/0"},
    {"caseName": "pair arrow in a radical step", "baseReactionFile": "radical-bromination-methane.json",
     "pathToSet": ["steps", 0, "canonicalArrows", 0], "newValue": "rad Br1 -> σ Br1-H2", "expectedViolationPath": "/steps/0/canonicalArrows/0"},
    {"caseName": "arrow without locus kinds", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["steps", 0, "canonicalArrows", 0], "newValue": "O1 -> C2", "expectedViolationPath": "/steps/0/canonicalArrows/0"},
    {"caseName": "arrow step without canonical arrows", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToDelete": ["steps", 0, "canonicalArrows"], "expectedViolationPath": "/steps/0"},
    {"caseName": "change step with arrows", "baseReactionFile": "aldol-addition-base.json",
     "pathToSet": ["steps", 1, "canonicalArrows"], "newValue": ["lp O1 -> σ O1-H4"], "expectedViolationPath": "/steps/1"},
    {"caseName": "change step that adds and removes nothing", "baseReactionFile": "aldol-addition-base.json",
     "pathToDelete": ["steps", 1, "addedSpecies"], "expectedViolationPath": "/steps/1"},
    {"caseName": "coordinate with three numbers", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "1"], "newValue": [0, 0, 0],
     "expectedViolationPath": "/stateIdToState/reactants/mapNumberToCoordinates/1"},
    {"caseName": "coordinate key that is not a map number", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["stateIdToState", "reactants", "mapNumberToCoordinates", "O1"], "newValue": [0, 0],
     "expectedViolationPath": "/stateIdToState/reactants/mapNumberToCoordinates"},
    {"caseName": "four hint tiers", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["stateIdToState", "reactants", "hintTiers"], "newValue": ["one", "two", "three", "four"],
     "expectedViolationPath": "/stateIdToState/reactants/hintTiers"},
    {"caseName": "misconception severity not wrong or plausible", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToSet": ["stateIdToState", "reactants", "misconceptions", 0, "severity"], "newValue": "bad",
     "expectedViolationPath": "/stateIdToState/reactants/misconceptions/0/severity"},
    {"caseName": "state without mapped SMILES", "baseReactionFile": "sn2-hydroxide-bromomethane.json",
     "pathToDelete": ["stateIdToState", "products", "mappedSmiles"], "expectedViolationPath": "/stateIdToState/products"}
  ]
}
