    {"caseName": "the other Kekulé benzene", "resultSmiles": "[CH:1]1[CH:2]=[CH:3][CH:4]=[CH:5][CH:6]=1", "targetSmiles": "[CH:1]1=[CH:2][CH:3]=[CH:4][CH:5]=[CH:6]1", "expectedComparison": "resonanceForm"},
