# Settings for running the backend server (make server) and draft sync on your own machine.
# Copy this file to .env (git ignores it) and fill in what you need; never commit real values.
# Nothing here is needed for `make check`, `make site`, `make dev` or `make editor`: the tests use
# PGlite (Postgres in memory) and the editor alone saves to content/reactions/.
# Each server variable is described in src/server/backendServer/settings/serverSettings.ts.
# Vite reads .env by itself, but only the VITE_ variables below. The server and draft sync read the
# environment, so load the file first:  set -a; . ./.env; set +a

# --- The backend server (make server) -----------------------------------------------------------

# A Postgres you run yourself, e.g.
#   docker run --rm -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:17
# The server applies its migrations at start.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# The server's own address; the OAuth apps send the browser back to <this>/api/auth/callback/github.
PUBLIC_BASE_URL=http://localhost:3000

# At least 32 random characters, e.g. from: openssl rand -base64 32
BETTER_AUTH_SECRET=

# A GitHub OAuth app of your own (GitHub → Settings → Developer settings → OAuth Apps), with the
# callback URL http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Your own numeric GitHub user id (https://api.github.com/users/<login>, "id"): that account signs
# in as the site's owner; anyone else signs in as a contributor.
ALLOWED_GITHUB_USER_IDS=

# Optional, together: a Google sign-in app (callback <PUBLIC_BASE_URL>/api/auth/callback/google).
# GOOGLE_CLIENT_ID=….apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Optional, together: the repository whose deploy workflow Publish starts. Leave unset locally.
# DEPLOY_REPOSITORY=owner/name
# DEPLOY_DISPATCH_TOKEN=

# Optional: the built editor (make editor-build) and the port.
# EDITOR_FILES_FOLDER=build/editor
# PORT=3000

# --- Draft sync (src/tooling/draftSync) ---------------------------------------------------------

# An access token for a Create server, and that server. Make a token with the server's settings
# loaded:  npx tsx src/server/backendServer/shell/runFromShell.ts create-token --user <email> --days 30
# ARROWPUSH_ACCESS_TOKEN=
# ARROWPUSH_SERVER_URL=http://localhost:3000

# --- Links between the two apps, read by Vite at build time -------------------------------------

# The learner site's address, for Create's "Back to the site" link (unset: no link).
# VITE_LEARNER_SITE_ADDRESS=http://localhost:5173
# Create's address, for the learner site's Create tab (unset: no tab).
# VITE_CREATE_ADDRESS=http://localhost:3000
