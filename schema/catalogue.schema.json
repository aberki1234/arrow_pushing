{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arrowpush.example/schema/catalogue.schema.json",
  "title": "Catalogue of published reactions and the daily calendar",
  "description": "catalogue.json, written by the catalogue build (src/catalogueBuilding) and read by the learner site (src/catalogue). See docs/schema-design.md section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "builtAt", "reactions", "dateToDailyReactionVersionRef"],
  "properties": {
    "formatVersion": {"const": 1},
    "builtAt": {
      "description": "UTC time of the build, e.g. 2026-12-01T10:00:00Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reactions": {
      "description": "One entry per reaction slug, sorted by slug.",
      "type": "array",
      "items": {"$ref": "#/$defs/catalogueEntry"}
    },
    "dateToDailyReactionVersionRef": {
      "description": "The daily calendar: a learner's local date to the reaction version played that day. Dates are never removed or changed by a later build.",
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/dateText"},
      "additionalProperties": {"$ref": "#/$defs/reactionVersionRef"}
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "dateText": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "reactionVersionRef": {
      "description": "<reaction slug>@<reaction version>, e.g. aldol-addition-base@3.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]*$"
    },
    "catalogueEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reactionSlug", "latestReactionVersion", "reactionVersionToContentHash", "title",
                   "subtitle", "reactionClasses", "difficultyTier", "dailyPuzzleEligible"],
      "properties": {
        "reactionSlug": {"$ref": "#/$defs/slug"},
        "latestReactionVersion": {"type": "integer", "minimum": 1},
        "reactionVersionToContentHash": {
          "description": "Every published version of the reaction to the full sha256 hex digest of its canonical file; the static file name uses the first 8 characters.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[1-9][0-9]*$"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": ["string", "null"]},
        "reactionClasses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "difficultyTier": {"type": "integer", "minimum": 1, "maximum": 3},
        "dailyPuzzleEligible": {"type": "boolean"}
      }
    }
  }
}
